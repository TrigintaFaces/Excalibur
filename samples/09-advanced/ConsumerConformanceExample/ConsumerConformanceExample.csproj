<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Version>$(VersionPrefix)</Version>
    <PackageId>$(AssemblyName)</PackageId>
    <!-- Sample demonstrates test infrastructure; underscores in conformance method names are expected. -->
    <NoWarn>$(NoWarn);CA1707;CA1050;CA1506</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="$(ExcaliburSourceRoot)Excalibur.Testing.Conformance\Excalibur.Testing.Conformance.csproj" />
    <ProjectReference Include="$(ExcaliburSourceRoot)Excalibur.Testing.Containers\Excalibur.Testing.Containers.csproj" />
  </ItemGroup>
</Project>
