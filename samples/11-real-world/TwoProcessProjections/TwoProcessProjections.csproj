<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Excalibur.Examples.TwoProcessProjections</RootNamespace>
    <AssemblyName>Excalibur.Examples.TwoProcessProjections</AssemblyName>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <!--
    ONE project, TWO roles, selected by the first argument. The topology under demonstration is a
    web API and a background jobs service deployed side by side against one database, which is what
    an on-premises deployment usually looks like. Running one project twice with different arguments
    gives two real OS processes sharing one SQL Server, which is the thing that matters here; a
    second csproj would only duplicate the domain.
  -->
  <ItemGroup>
    <ProjectReference Include="$(DispatchSourceRoot)Excalibur.Dispatch\Excalibur.Dispatch.csproj" />
    <ProjectReference Include="$(DispatchSourceRoot)Excalibur.Dispatch.Abstractions\Excalibur.Dispatch.Abstractions.csproj" />
    <ProjectReference Include="$(ExcaliburSourceRoot)Excalibur.Domain\Excalibur.Domain.csproj" />
    <ProjectReference Include="$(ExcaliburSourceRoot)Excalibur.EventSourcing\Excalibur.EventSourcing.csproj" />
    <ProjectReference Include="$(ExcaliburSourceRoot)Excalibur.EventSourcing.SqlServer\Excalibur.EventSourcing.SqlServer.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Update="scripts\schema.sql" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
