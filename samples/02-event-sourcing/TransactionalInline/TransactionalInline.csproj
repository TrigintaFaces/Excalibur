<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Excalibur.Examples.TransactionalInline</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="$(ExcaliburSourceRoot)Excalibur.EventSourcing/Excalibur.EventSourcing.csproj" />
    <ProjectReference Include="$(ExcaliburSourceRoot)Excalibur.EventSourcing.SqlServer/Excalibur.EventSourcing.SqlServer.csproj" />
    <ProjectReference Include="$(ExcaliburSourceRoot)Excalibur.EventSourcing.Postgres/Excalibur.EventSourcing.Postgres.csproj" />
    <ProjectReference Include="$(ExcaliburSourceRoot)Excalibur.EventSourcing.Sqlite/Excalibur.EventSourcing.Sqlite.csproj" />
    <ProjectReference Include="$(ExcaliburSourceRoot)Excalibur.EventSourcing.Oracle/Excalibur.EventSourcing.Oracle.csproj" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <None Include="$(ExcaliburSourceRoot)Excalibur.EventSourcing.SqlServer/Scripts/001_CreateEventStoreSchema.sql" Link="event-store.sql" CopyToOutputDirectory="PreserveNewest" />
    <None Include="$(ExcaliburSourceRoot)Excalibur.EventSourcing.Postgres/Scripts/002_CreateEventStoreSchema.sql" Link="event-store-postgres.sql" CopyToOutputDirectory="PreserveNewest" />
    <None Include="$(ExcaliburSourceRoot)Excalibur.EventSourcing.Oracle/Scripts/002_CreateEventStoreSchema.sql" Link="event-store-oracle.sql" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
