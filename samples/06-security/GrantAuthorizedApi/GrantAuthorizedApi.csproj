<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Version>$(VersionPrefix)</Version>
    <PackageId>$(AssemblyName)</PackageId>
  </PropertyGroup>
  <!-- Grant authorization on plain ASP.NET Core endpoints: no Dispatch pipeline involved. -->
  <ItemGroup>
    <ProjectReference Include="$(ExcaliburSourceRoot)Excalibur.A3.AspNetCore\Excalibur.A3.AspNetCore.csproj" />
  </ItemGroup>
</Project>
