<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- This sample is the ahead-of-time acceptance surface: it must be able to REPORT trim
         warnings. The shared samples NoWarn silences IL2026 for demo code; strip it back out here,
         because a sample that cannot warn cannot prove anything about trimming. -->
    <NoWarn>$(NoWarn.Replace('IL2026',''));CA1506;CA1505</NoWarn>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Samples intentionally demonstrate full feature integration, which requires coupling -->
    <!-- AOT Configuration -->
    <PublishAot>true</PublishAot>
    <TrimMode>full</TrimMode>
    <!-- Reflection-based JSON is OFF, which is the ahead-of-time default. Every type this
         sample serializes must therefore be reachable through a JsonSerializerContext. Turning
         this back on would let serialization silently fall back to reflection at run time, which
         is exactly the failure this sample exists to surface. -->
    <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <SuppressTrimAnalysisWarnings>false</SuppressTrimAnalysisWarnings>
    <TrimmerSingleWarn>false</TrimmerSingleWarn>
    <!-- Source Generator Visibility -->
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <CompilerGeneratedFilesOutputPath>$(BaseIntermediateOutputPath)GeneratedFiles</CompilerGeneratedFilesOutputPath>
    <!-- C# 12 Interceptors (required for DispatchInterceptorGenerator) -->
    <InterceptorsNamespaces>$(InterceptorsNamespaces);Excalibur.Dispatch.Generated</InterceptorsNamespaces>
    <!-- Package Metadata -->
    <Version>$(VersionPrefix)</Version>
    <PackageId>$(AssemblyName)</PackageId>
  </PropertyGroup>
  <!-- Dispatch dependencies with source generators -->
  <ItemGroup>
    <ProjectReference Include="$(DispatchSourceRoot)Excalibur.Dispatch.Abstractions\Excalibur.Dispatch.Abstractions.csproj" />
    <ProjectReference Include="$(DispatchSourceRoot)Excalibur.Dispatch\Excalibur.Dispatch.csproj" />
    <ProjectReference Include="$(DispatchSourceRoot)Excalibur.Dispatch.SourceGenerators\Excalibur.Dispatch.SourceGenerators.csproj" ReferenceOutputAssembly="false" OutputItemType="Analyzer" PrivateAssets="all" />
  </ItemGroup>
  <!-- S2: Event Sourcing dependencies -->
  <ItemGroup>
    <ProjectReference Include="$(ExcaliburSourceRoot)Excalibur.Domain\Excalibur.Domain.csproj" />
    <ProjectReference Include="$(ExcaliburSourceRoot)Excalibur.EventSourcing.Abstractions\Excalibur.EventSourcing.Abstractions.csproj" />
    <ProjectReference Include="$(ExcaliburSourceRoot)Excalibur.EventSourcing\Excalibur.EventSourcing.csproj" />
    <ProjectReference Include="$(ExcaliburSourceRoot)Excalibur.EventSourcing.InMemory\Excalibur.EventSourcing.InMemory.csproj" />
  </ItemGroup>
  <!-- S4: Compliance dependencies (SOC 2 configuration binding + report export) -->
  <ItemGroup>
    <ProjectReference Include="$(ExcaliburSourceRoot)Excalibur.Compliance.Abstractions\Excalibur.Compliance.Abstractions.csproj" />
    <ProjectReference Include="$(ExcaliburSourceRoot)Excalibur.Compliance\Excalibur.Compliance.csproj" />
  </ItemGroup>
</Project>