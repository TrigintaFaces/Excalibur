# Auto-detect text files and ensure consistent line endings
* text=auto

# Explicitly declare text files to ensure normalization
*.cs        text diff=csharp
*.csproj    text
*.sln       text
*.slnf      text
*.json      text
*.jsonl     text
*.xml       text
*.yaml      text
*.yml       text
*.md        text
*.txt       text
*.ps1       text
*.sh        text eol=lf
*.bash      text eol=lf
*.props     text
*.targets   text
*.config    text
*.editorconfig text
*.razor     text
*.cshtml    text
*.html      text
*.css       text
*.js        text
*.ts        text

# Binary files
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.ico       binary
*.snk       binary
*.pfx       binary
*.dll       binary
*.exe       binary
*.nupkg     binary

# Use bd merge for beads JSONL files
.beads/beads.jsonl merge=beads

# Migration-drift fixtures: these hold a specific line-ending convention as their SUBJECT, not
# as formatting. The pair proves a migrator accepts the CRLF and LF renderings of one committed
# script as the same script -- the false positive that would otherwise stop a consumer's service
# after a cross-platform package upgrade. Under `* text=auto` both files would be checked out
# with the same terminators and the test would compare a file against itself, so the eol
# declarations below are load-bearing. The test asserts the two resources differ in bytes and
# fails naming this file if they do not, so a regression here reports itself.
tests/integration/Excalibur.Integration.Tests/Fixtures/MigrationDrift/Original/*.sql      text eol=lf
tests/integration/Excalibur.Integration.Tests/Fixtures/MigrationDrift/Edited/*.sql        text eol=lf
tests/integration/Excalibur.Integration.Tests/Fixtures/MigrationDrift/OriginalCrlf/*.sql  text eol=crlf

# Generated SPA build output is a COMMITTED ARTIFACT that CI rebuilds and compares byte-for-byte.
# `text` alone normalises the blob but still checks out CRLF on Windows, so the working tree and the
# blob disagree there — and a committed CRLF blob disagrees with every Linux checkout, which is a
# drift no rebuild can fix. eol=lf pins both sides to the same bytes on every platform.
src/Excalibur/Excalibur.Operations.Dashboard.Spa/wwwroot/**   text eol=lf
#
# The SOURCE template is pinned too, and that is not belt-and-braces. Vite copies the template's own
# lines into the output VERBATIM and emits only its injected lines itself, so a CRLF template on Windows
# produces an output with MIXED endings -- one CRLF line among LFs. Pinning only the output leaves that
# byte to come back on the next Windows build, which is exactly the drift this pair exists to stop.
src/Excalibur/Excalibur.Operations.Dashboard.Spa/ClientApp/index.html   text eol=lf
