<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Floats to the newest 10.0.0 PRERELEASE, which is what is published today. A bare
         10.* asks for >= 10.0.0 STABLE, which does not exist yet, so a fresh scaffold fails
         restore with NU1102 before the consumer has written a line of code. Change this to
         10.* AT the 10.0.0 stable cut - not before - so a scaffold then stops resolving
         prereleases. -->
    <ExcaliburDispatchVersion Condition="'$(ExcaliburDispatchVersion)' == ''">10.0.0-*</ExcaliburDispatchVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Excalibur.Dispatch" Version="$(ExcaliburDispatchVersion)" />
    <PackageReference Include="Excalibur.Dispatch.Hosting.AspNetCore" Version="$(ExcaliburDispatchVersion)" />
    <PackageReference Include="Excalibur.Dispatch.Observability" Version="$(ExcaliburDispatchVersion)" />
    <PackageReference Include="Excalibur.Domain" Version="$(ExcaliburDispatchVersion)" />
    <PackageReference Include="Excalibur.EventSourcing" Version="$(ExcaliburDispatchVersion)" />
    <PackageReference Include="Excalibur.Hosting" Version="$(ExcaliburDispatchVersion)" />
    <!--#if (UseSqlServer) -->
    <PackageReference Include="Excalibur.EventSourcing.SqlServer" Version="$(ExcaliburDispatchVersion)" />
    <!--#endif -->
    <!--#if (UsePostgreSql) -->
    <PackageReference Include="Excalibur.EventSourcing.Postgres" Version="$(ExcaliburDispatchVersion)" />
    <!--#endif -->
  </ItemGroup>

</Project>
