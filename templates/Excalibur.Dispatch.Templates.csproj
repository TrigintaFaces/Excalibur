<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageType>Template</PackageType>
    <PackageVersion>0.1.0</PackageVersion>
    <PackageId>Excalibur.Dispatch.Templates</PackageId>
    <Title>Excalibur.Dispatch Project Templates</Title>
    <Description>dotnet new templates for Dispatch and Excalibur projects</Description>
    <PackageTags>dotnet-new;templates;dispatch;excalibur;eventsourcing;cqrs;ddd</PackageTags>
    <IncludeContentInPack>true</IncludeContentInPack>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <ContentTargetFolders>content</ContentTargetFolders>
    <NoDefaultExcludes>true</NoDefaultExcludes>
    <TargetFramework>netstandard2.0</TargetFramework>
    <!-- NU5128: a template package ships content only and deliberately has no lib/ref assembly,
         so the dependency-group/lib-folder correspondence NuGet checks for cannot exist here.
         Narrowly suppressed for that documented reason; it is not a blanket relaxation. -->
    <NoWarn>$(NoWarn);NU5128</NoWarn>
    <!-- The isolating props blank PackageReadmeFile for template CONTENT; this package is the
         shipped artifact a consumer sees on the gallery, so it carries its own readme. -->
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <Content Include="dispatch-api\**\*" Exclude="dispatch-api\**\bin\**;dispatch-api\**\obj\**" />
    <Content Include="dispatch-worker\**\*" Exclude="dispatch-worker\**\bin\**;dispatch-worker\**\obj\**" />
    <Content Include="excalibur-ddd\**\*" Exclude="excalibur-ddd\**\bin\**;excalibur-ddd\**\obj\**" />
    <Content Include="excalibur-cqrs\**\*" Exclude="excalibur-cqrs\**\bin\**;excalibur-cqrs\**\obj\**" />
    <Content Include="dispatch-serverless\**\*" Exclude="dispatch-serverless\**\bin\**;dispatch-serverless\**\obj\**" />
    <Content Include="dispatch-minimal-api\**\*" Exclude="dispatch-minimal-api\**\bin\**;dispatch-minimal-api\**\obj\**" />
    <Content Include="excalibur-saga\**\*" Exclude="excalibur-saga\**\bin\**;excalibur-saga\**\obj\**" />
    <Content Include="excalibur-outbox\**\*" Exclude="excalibur-outbox\**\bin\**;excalibur-outbox\**\obj\**" />
    <Compile Remove="**\*" />
  </ItemGroup>
</Project>
