<Project Sdk="Microsoft.NET.Sdk.Worker">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- The test project is a nested folder of this one, so EVERY default item glob here
         reaches into it - not just the C# one. This is the SDK's own hook for that and covers
         all of them. Without it the Web/Worker SDK's **/*.json and **/*.config content globs
         sweep the test project's own bin/ and obj/ restore artifacts into this project's
         content, and a ProjectReference then copies them into the test project's output under
         a folder named after the test assembly - which on Unix is the exact path the
         extensionless apphost needs, so the build fails with MSB3024. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);Company.DispatchWorker.Tests/**</DefaultItemExcludes>
    <!-- Floats to the newest 10.0.0 PRERELEASE, which is what is published today. A bare
         10.* asks for >= 10.0.0 STABLE, which does not exist yet, so a fresh scaffold fails
         restore with NU1102 before the consumer has written a line of code. Change this to
         10.* AT the 10.0.0 stable cut - not before - so a scaffold then stops resolving
         prereleases. -->
    <ExcaliburDispatchVersion Condition="'$(ExcaliburDispatchVersion)' == ''">10.0.0-*</ExcaliburDispatchVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Excalibur.Dispatch" Version="$(ExcaliburDispatchVersion)" />
    <PackageReference Include="Excalibur.Dispatch.Observability" Version="$(ExcaliburDispatchVersion)" />
    <!--#if (UseKafka) -->
    <PackageReference Include="Excalibur.Dispatch.Transport.Kafka" Version="$(ExcaliburDispatchVersion)" />
    <!--#endif -->
    <!--#if (UseRabbitMQ) -->
    <PackageReference Include="Excalibur.Dispatch.Transport.RabbitMQ" Version="$(ExcaliburDispatchVersion)" />
    <!--#endif -->
    <!--#if (UseAzureServiceBus) -->
    <PackageReference Include="Excalibur.Dispatch.Transport.AzureServiceBus" Version="$(ExcaliburDispatchVersion)" />
    <!--#endif -->
    <!--#if (UseAwsSqs) -->
    <PackageReference Include="Excalibur.Dispatch.Transport.AwsSqs" Version="$(ExcaliburDispatchVersion)" />
    <!--#endif -->
    <!--#if (UseGooglePubSub) -->
    <PackageReference Include="Excalibur.Dispatch.Transport.GooglePubSub" Version="$(ExcaliburDispatchVersion)" />
    <!--#endif -->
  </ItemGroup>

</Project>
