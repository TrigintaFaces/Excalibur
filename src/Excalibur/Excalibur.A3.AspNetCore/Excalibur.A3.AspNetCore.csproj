<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <!-- NuGet Package Metadata -->
    <PackageId>Excalibur.A3.AspNetCore</PackageId>
    <Description>ASP.NET Core integration for Excalibur A3 grant authorization: bridges the authenticated request principal into grant evaluation and adds per-request resource scope for controller and minimal-API endpoints.</Description>
    <PackageTags>excalibur;authorization;aspnetcore;grants;security;minimal-api</PackageTags>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>
  <ItemGroup>
    <!-- Package SPLIT rather than adding this framework reference to Excalibur.A3: A3 is consumed by
         workers, serverless functions and console hosts that must not be forced onto the ASP.NET Core
         shared framework. Consumers who host HTTP endpoints take this package; everyone else does not. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Excalibur.A3\Excalibur.A3.csproj" />
  </ItemGroup>
  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>Excalibur.A3.AspNetCore.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>
</Project>
