<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <!-- Analyzers/code-fixes MUST target netstandard2.0 only -->
    <TargetFramework>netstandard2.0</TargetFramework>
    <TargetFrameworks></TargetFrameworks>
    <!-- CPM opt-out: pin Roslyn SDK to the minimum compiler version supported (must not float). -->
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
    <EnableDefaultAnalyzers>false</EnableDefaultAnalyzers>
    <IsRoslynComponent>true</IsRoslynComponent>
    <IncludeBuildOutput>true</IncludeBuildOutput>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <IncludeSymbols>false</IncludeSymbols>
    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
    <!-- Contributes its assembly to Excalibur.Workflows.Analyzers rather than shipping alone. A
         consumer installing the analyzers previously received diagnostics with no way to apply
         them; the fixes now travel with the diagnostics that raise them. -->
    <IsPackable>false</IsPackable>
    <NoWarn>$(NoWarn);NU5017;NU5128;RS2008</NoWarn>
    <LangVersion>12.0</LangVersion>
    <Nullable>enable</Nullable>
    <IsAotCompatible>false</IsAotCompatible>
    <EnableAotAnalyzer>false</EnableAotAnalyzer>
    <IsTrimmable>false</IsTrimmable>
    <EnableTrimAnalyzer>false</EnableTrimAnalyzer>
    <Description>Roslyn code-fix providers for the Excalibur.Workflows.Analyzers determinism diagnostics: rewrites non-deterministic API calls inside workflow bodies to the deterministic IWorkflowContext primitives.</Description>
    <PackageTags>workflow;durable;determinism;codefix;roslyn;excalibur</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>Excalibur.Workflows.Analyzers.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Remove="Microsoft.SourceLink.GitHub" />
    <PackageReference Remove="Microsoft.CodeAnalysis.Analyzers" />
    <PackageReference Remove="Microsoft.CodeAnalysis.NetAnalyzers" />
    <PackageReference Remove="Microsoft.CodeAnalysis.PublicApiAnalyzers" />
    <PackageReference Remove="Microsoft.CodeAnalysis.BannedApiAnalyzers" />
    <PackageReference Remove="StyleCop.Analyzers" />
    <PackageReference Remove="Meziantou.Analyzer" />
    <PackageReference Remove="Roslynator.Analyzers" />
  </ItemGroup>
  <ItemGroup>
    <!--
      This project sets ManagePackageVersionsCentrally=false (above), so these versions MUST be
      pinned here and MUST be kept equal to the Roslyn version the sibling Analyzers project
      resolves from central package management (Directory.Packages.props). They were 4.14.0 while
      Analyzers was on 5.3.0, so this project loaded Microsoft.CodeAnalysis 4.14.0 while linking the
      Analyzers assembly built against 5.3.0 (project-referenced below for the shared EXWF diagnostic
      id constants). MSB3277 reports that as an unresolvable conflict and the build fails.

      A code-fix provider and the analyzer whose diagnostics it fixes must compile against ONE Roslyn
      version. Because this side is pinned and the other is central, they do not move together: when
      Directory.Packages.props changes Microsoft.CodeAnalysis, change these three to match.
    -->
    <PackageReference Include="Microsoft.CodeAnalysis.Common" Version="5.3.0" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.3.0" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="5.3.0" PrivateAssets="all" />
    <!--
      Unifies System.Collections.Immutable. Microsoft.CodeAnalysis.Common 5.3.0 brings 9.0.0
      transitively, while the project-referenced Analyzers assembly is built against 10.0.0 from
      central package management. That is a second MSB3277 conflict, distinct from the Roslyn one
      above: locally it is only a warning, but CI escalates warnings to errors, so it fails there and
      not here. Keep this equal to the System.Collections.Immutable version in
      Directory.Packages.props.
    -->
    <PackageReference Include="System.Collections.Immutable" Version="10.0.7" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <!-- Shares the EXWF diagnostic ID constants (FixableDiagnosticIds); compile-time only, not packed. -->
    <ProjectReference Include="..\Excalibur.Workflows.Analyzers\Excalibur.Workflows.Analyzers.csproj" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <None Include="$(OutputPath)\$(AssemblyName).dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
  </ItemGroup>
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
