<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageId>Excalibur.Jobs.SqlServer</PackageId>
    <Description>SQL Server implementation of distributed job coordination for the Excalibur framework. Uses Dapper for data access with distributed locking, instance registry, and job distribution.</Description>
    <PackageTags>excalibur;jobs;scheduling;sqlserver;distributed;coordination</PackageTags>
    <IsAotCompatible>false</IsAotCompatible>
    <EnableConfigurationBindingGenerator>true</EnableConfigurationBindingGenerator>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Excalibur.Jobs.Tests" />
    <InternalsVisibleTo Include="Excalibur.Tests.Unit" />
    <InternalsVisibleTo Include="Excalibur.Tests.Integration" />
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Dapper" />
    <PackageReference Include="Microsoft.Data.SqlClient" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
    <PackageReference Include="System.Text.Json" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Excalibur.Jobs\Excalibur.Jobs.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Shipped schema: a consumer cannot obtain this DDL unless it is packed, and the
         framework does not auto-create tables. Glob matches where the .sql actually lives.
         This package deliberately embeds NOTHING: an EmbeddedResource copy would be a second,
         invisible copy of the schema that no code in this assembly reads, so it could only
         drift from the packed one while reading as deliberate provisioning. The packed script
         under scripts/ is the single obtainable copy. -->

    <None Include="Sql\*.sql" Pack="true" PackagePath="scripts\" />
  </ItemGroup>
</Project>