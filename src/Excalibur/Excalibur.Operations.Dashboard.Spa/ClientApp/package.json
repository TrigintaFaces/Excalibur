{
  "name": "excalibur-operations-dashboard-spa",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Svelte single-page app for the Excalibur Operations Dashboard. Built to static assets embedded into the .NET package.",
  "scripts": {
    "dev": "vite",
    "build": "svelte-check --tsconfig ./tsconfig.json && vite build",
    "build:nocheck": "vite build",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/svelte": "^5.4.2",
    "@vitest/coverage-v8": "^4.1.11",
    "jsdom": "^30.0.1",
    "svelte": "^5.56.10",
    "svelte-check": "^4.7.6",
    "tslib": "^2.7.0",
    "typescript": "^5.6.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.10"
  }
}
