<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageId>Excalibur.Saga.Oracle</PackageId>
    <Description>Oracle Database implementation of the saga pattern for Excalibur, providing durable saga state persistence with optimistic concurrency control using Oracle as the backing store.</Description>
    <PackageTags>excalibur;saga;process-manager;workflow;distributed-transactions;oracle;dapper</PackageTags>
    <IsAotCompatible>true</IsAotCompatible>
    <DispatchPackageVersion Condition="'$(DispatchPackageVersion)' == ''">0.0.0-local</DispatchPackageVersion>
  </PropertyGroup>
  <!-- AOT Configuration -->
  <PropertyGroup>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <PublishAot Condition="'$(PublishAot)' == ''">false</PublishAot>
  </PropertyGroup>
  <PropertyGroup>
    <SuppressTrimAnalysisWarnings>false</SuppressTrimAnalysisWarnings>
    <TrimmerDefaultAction>link</TrimmerDefaultAction>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Dapper" />
    <PackageReference Include="Oracle.ManagedDataAccess.Core" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Excalibur.Saga.Oracle.Tests" />
  </ItemGroup>
  <ItemGroup>
    <!-- EXDATA001/002 run on this project's own build. The analyzer ships to consumers bundled
         inside Excalibur.Data.Abstractions, but PrivateAssets="all" stops it flowing here by
         ProjectReference, so without this line the request types it was written for are the one
         population it never sees. -->
    <ProjectReference Include="..\Excalibur.Data.Analyzers\Excalibur.Data.Analyzers.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" PrivateAssets="all" />
    <ProjectReference Include="..\Excalibur.Saga\Excalibur.Saga.csproj" />
    <ProjectReference Include="..\Excalibur.Data.Abstractions\Excalibur.Data.Abstractions.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(UsePackageReferences)' != 'true'">
    <ProjectReference Include="..\..\Dispatch\Excalibur.Dispatch.Abstractions\Excalibur.Dispatch.Abstractions.csproj" />
  </ItemGroup>
  <!-- CI mode: PackageReference for Dispatch packages -->
  <ItemGroup Condition="'$(UsePackageReferences)' == 'true'">
    <PackageReference Include="Excalibur.Dispatch.Abstractions" VersionOverride="$(DispatchPackageVersion)" />
  </ItemGroup>
  <ItemGroup>
    <!-- Shipped schema: a consumer cannot obtain this DDL unless it is packed, and the
         framework does not auto-create tables. Glob matches where the .sql actually lives. -->
    <None Include="Scripts\*.sql" Pack="true" PackagePath="scripts\" />
  </ItemGroup>
</Project>
