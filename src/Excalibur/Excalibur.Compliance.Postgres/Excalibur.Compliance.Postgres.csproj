<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageId>Excalibur.Compliance.Postgres</PackageId>
    <Description>Postgres implementation of GDPR compliance stores for the Excalibur framework. Provides erasure request tracking, legal hold management, and data inventory using Dapper and Npgsql.</Description>
    <PackageTags>compliance;postgres;dapper;gdpr;erasure;legal-hold;data-inventory</PackageTags>
    <IsAotCompatible>true</IsAotCompatible>
    <!-- The Add*(IConfiguration) overloads in this assembly call OptionsBuilder<T>.Bind/BindConfiguration.
         The source-generated configuration binder rewrites those call sites, at this assembly's own compile
         time, into generated reflection-free code instead of ConfigurationBinder's reflection path. Enabling
         it here, rather than relying on a consumer to opt in, is what makes the IConfiguration overloads
         genuinely trim- and AOT-safe. -->
    <EnableConfigurationBindingGenerator>true</EnableConfigurationBindingGenerator>
    <DispatchPackageVersion Condition="'$(DispatchPackageVersion)' == ''">0.0.0-local</DispatchPackageVersion>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Excalibur.Data.Postgres.Tests" />
    <InternalsVisibleTo Include="Excalibur.Compliance.Tests" />
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Excalibur.Data.Abstractions\Excalibur.Data.Abstractions.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(UsePackageReferences)' != 'true'">
    <ProjectReference Include="..\Excalibur.Compliance\Excalibur.Compliance.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Dapper" />
    <PackageReference Include="Npgsql" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options" />
    <PackageReference Include="Microsoft.Extensions.Options.DataAnnotations" />
    <PackageReference Include="System.Text.Json" />
  </ItemGroup>
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/" />
    <None Include="Scripts\*.sql" Pack="true" PackagePath="scripts\" />
  </ItemGroup>
  <!-- CI mode: PackageReference for Dispatch packages -->
  <ItemGroup Condition="'$(UsePackageReferences)' == 'true'">
    <PackageReference Include="Excalibur.Compliance" VersionOverride="$(DispatchPackageVersion)" />
  </ItemGroup>
</Project>
