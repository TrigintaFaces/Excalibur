<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageId>Excalibur.Compliance</PackageId>
    <Description>Compliance implementations for the Excalibur framework. Provides AES-256-GCM encryption, key management, key rotation, and FIPS 140-2 validation for SOC2/GDPR requirements. SOC 2 reports export to JSON, CSV, XML, Excel and text; PDF export is opt-in via the separate Excalibur.Compliance.Pdf package.</Description>
    <PackageTags>compliance;encryption;aes-gcm;key-management;gdpr;soc2;security;fips</PackageTags>
    <!-- AOT: Reflection-using methods (encryption, masking, retention) carry [RequiresUnreferencedCode]/[RequiresDynamicCode]. -->
    <IsAotCompatible>true</IsAotCompatible>
    <!-- The Add*(IConfiguration) overloads in this assembly call OptionsBuilder<T>.Bind(configuration).
         The source-generated config binder makes those calls interceptor-rewritten to generated,
         reflection-free code at THIS assembly's own compile time, instead of falling back to
         ConfigurationBinder.Bind()'s reflection path, which silently drops nested record properties
         (e.g. Soc2Options.SystemDescription) under trimming. Enabling it here, not just when a
         consumer opts in, is what makes AddSoc2Compliance(IConfiguration) actually AOT-safe. -->
    <EnableConfigurationBindingGenerator>true</EnableConfigurationBindingGenerator>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Update="Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
    <Compile Update="Resources.Designer.cs">
      <DesignTime>true</DesignTime>
      <AutoGen>true</AutoGen>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Excalibur.Compliance.Tests" />
    <InternalsVisibleTo Include="Excalibur.Dispatch.Security.Tests" />
    <!-- The SqlServer escrow provider delegates to the internal QuorumRecoverySeam so the M-of-N
         quorum invariant lives in exactly one place across both first-party provider assemblies. -->
    <InternalsVisibleTo Include="Excalibur.Compliance.SqlServer" />
    <InternalsVisibleTo Include="Excalibur.Dispatch.Benchmarks" />
    <InternalsVisibleTo Include="Excalibur.Compliance.Benchmarks" />
    <InternalsVisibleTo Include="Excalibur.Dispatch.Observability.Tests" />
    <InternalsVisibleTo Include="Excalibur.Testing.Conformance.Tests" />
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
    <!-- Real-infrastructure lock for the internal encrypting decorator's scoped-transactional forward: the
         atomic guarantee through a DECORATED store can only be proven against a live provider transaction. -->
    <InternalsVisibleTo Include="Excalibur.Integration.Tests" />
    <!-- Parity lock for the in-memory stores' tenant term: the property under test is that the in-memory
         and relational stores persist the SAME spelling of an absent tenant, so one half of every
         comparison is a real server and the other is this assembly's internal store. -->
    <InternalsVisibleTo Include="Excalibur.Dispatch.Integration.Tests" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Excalibur.Compliance.Abstractions\Excalibur.Compliance.Abstractions.csproj" />
    <ProjectReference Include="..\..\Dispatch\Excalibur.Dispatch.Abstractions\Excalibur.Dispatch.Abstractions.csproj" />
    <PackageReference Include="Dapper" />
    <PackageReference Include="Microsoft.Extensions.Caching.Memory" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
    <PackageReference Include="Microsoft.Extensions.Options.DataAnnotations" />
  </ItemGroup>
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>