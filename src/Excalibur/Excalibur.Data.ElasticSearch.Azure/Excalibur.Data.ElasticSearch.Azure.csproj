<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <!-- Deliberately the SAME namespace as the base package. These types were shipped under it, and
         keeping it means a consumer who already uses Azure Key Vault credential storage changes a
         project file and nothing else: no using directive, no source edit. -->
    <RootNamespace>Excalibur.Data.ElasticSearch.Security</RootNamespace>
    <AssemblyName>Excalibur.Data.ElasticSearch.Azure</AssemblyName>
    <IsAotCompatible>true</IsAotCompatible>
    <PackageId>Excalibur.Data.ElasticSearch.Azure</PackageId>
    <Description>Azure Key Vault connection-credential storage for Excalibur.Data.ElasticSearch. Optional: install this only if you back Elasticsearch authentication secrets with Key Vault.</Description>
    <PackageTags>excalibur;data;elasticsearch;azure;keyvault;credentials</PackageTags>
    <DispatchPackageVersion Condition="'$(DispatchPackageVersion)' == ''">0.0.0-local</DispatchPackageVersion>
  </PropertyGroup>
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Excalibur.Data.ElasticSearch\Excalibur.Data.ElasticSearch.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- The whole point of this package: these two live here so the base package does not carry them. -->
    <PackageReference Include="Azure.Identity" />
    <PackageReference Include="Azure.Security.KeyVault.Secrets" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Excalibur.Data.ElasticSearch.Tests" />
    <InternalsVisibleTo Include="Excalibur.Tests" />
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
  </ItemGroup>
</Project>
