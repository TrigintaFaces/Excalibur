<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageId>Excalibur.Inbox</PackageId>
    <Description>Inbox pattern abstractions for Excalibur, providing the IInboxBuilder for fluent provider configuration.</Description>
    <PackageTags>excalibur;inbox;idempotent;messaging;builder</PackageTags>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
  </ItemGroup>
  <!-- Development mode: Dispatch ProjectReferences -->
  <ItemGroup Condition="'$(UsePackageReferences)' != 'true'">
    <ProjectReference Include="..\..\Dispatch\Excalibur.Dispatch.Abstractions\Excalibur.Dispatch.Abstractions.csproj" />
  </ItemGroup>
  <!-- CI mode: PackageReference for Dispatch packages -->
  <ItemGroup Condition="'$(UsePackageReferences)' == 'true'">
    <PackageReference Include="Excalibur.Dispatch.Abstractions" VersionOverride="$(DispatchPackageVersion)" />
  </ItemGroup>
  <!-- Provider stores call the internal InboxSchemaContract; the Oracle test project unit-tests it. -->
  <ItemGroup>
    <InternalsVisibleTo Include="Excalibur.Data.SqlServer.Tests" />
    <InternalsVisibleTo Include="Excalibur.Inbox.SqlServer" />
    <InternalsVisibleTo Include="Excalibur.Inbox.Postgres" />
    <InternalsVisibleTo Include="Excalibur.Inbox.Oracle" />
    <!-- Document stores address an entry by a single id and compose it through the internal
         InboxDocumentKey, so the injective composition has one definition rather than a copy per
         provider that can drift. -->
    <InternalsVisibleTo Include="Excalibur.Inbox.Firestore" />
    <InternalsVisibleTo Include="Excalibur.Inbox.ElasticSearch" />
    <InternalsVisibleTo Include="Excalibur.Inbox.Oracle.Tests" />
    <!-- Real-infrastructure lock for the internal telemetry decorator's scoped-transactional forward: the
         atomic guarantee through a DECORATED store can only be proven against a live provider transaction. -->
    <InternalsVisibleTo Include="Excalibur.Integration.Tests" />
  </ItemGroup>
</Project>
