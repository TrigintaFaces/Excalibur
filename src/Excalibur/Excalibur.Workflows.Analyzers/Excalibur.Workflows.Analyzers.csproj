<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <!-- Analyzers MUST target netstandard2.0 only - override multi-targeting from Directory.Build.props -->
    <TargetFramework>netstandard2.0</TargetFramework>
    <TargetFrameworks></TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <!-- Required so include-symbols can produce a non-empty snupkg in CI -->
    <IncludeBuildOutput>true</IncludeBuildOutput>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <IncludeSymbols>false</IncludeSymbols>
    <DevelopmentDependency>true</DevelopmentDependency>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <!-- Disable AOT analysis - not applicable to analyzers (run in compiler, not runtime) -->
    <IsAotCompatible>false</IsAotCompatible>
    <IsTrimmable>false</IsTrimmable>
    <EnableAotAnalyzer>false</EnableAotAnalyzer>
    <EnableTrimAnalyzer>false</EnableTrimAnalyzer>
  </PropertyGroup>
  <PropertyGroup>
    <PackageId>Excalibur.Workflows.Analyzers</PackageId>
    <Title>Workflow Determinism Analyzers</Title>
    <Description>Roslyn analyzers that flag non-deterministic API usage (DateTime.Now, Guid.NewGuid, ...) inside durable workflow bodies, which would break deterministic replay. Suggests the deterministic IWorkflowContext primitives instead.</Description>
    <PackageTags>roslyn;analyzer;workflow;durable;determinism;excalibur</PackageTags>
    <NoWarn>$(NoWarn);NU5017;NU5128;RS2007;RS2008</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>Excalibur.Workflows.Analyzers.Tests</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>Excalibur.Workflows.CodeFixes</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <None Include="$(OutputPath)\$(AssemblyName).dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
    <!-- BUNDLE the code fixes beside the diagnostics that raise them. Excalibur.Workflows.CodeFixes
         references THIS project, so it is built by the time this packs; taking it by path avoids the
         reference cycle a ProjectReference back to it would create. -->
    <None Include="..\Excalibur.Workflows.CodeFixes\bin\$(Configuration)\netstandard2.0\Excalibur.Workflows.CodeFixes.dll"
          Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
  </ItemGroup>
  <ItemGroup>
    <AdditionalFiles Include="AnalyzerReleases.Shipped.md" />
    <AdditionalFiles Include="AnalyzerReleases.Unshipped.md" />
  </ItemGroup>
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
