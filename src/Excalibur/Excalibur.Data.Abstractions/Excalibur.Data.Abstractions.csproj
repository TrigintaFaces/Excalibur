<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RootNamespace>Excalibur.Data</RootNamespace>
    <AssemblyName>Excalibur.Data.Abstractions</AssemblyName>
    <!-- NuGet Package Metadata -->
    <PackageId>Excalibur.Data.Abstractions</PackageId>
    <Description>Core abstractions for the Excalibur data persistence layer, supporting multiple database providers.</Description>
    <PackageTags>excalibur;data;abstractions;persistence;dapper</PackageTags>
    <IsAotCompatible>true</IsAotCompatible>
    <DispatchPackageVersion Condition="'$(DispatchPackageVersion)' == ''">0.0.0-local</DispatchPackageVersion>
  </PropertyGroup>
  <!-- Include README.md in NuGet package -->
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Dapper" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options" />
    <PackageReference Include="System.Diagnostics.DiagnosticSource" />
  </ItemGroup>
  <!-- Excalibur internal references (always ProjectReference) -->
  <ItemGroup>
    <ProjectReference Include="..\Excalibur.Domain\Excalibur.Domain.csproj" />
    <!-- The tenancy diagnostics (EXDATA001-002) run on this project's own build AND are bundled into this
         package (see the pack ItemGroup below), so every consumer that writes a DataRequest gets them with
         zero extra install and zero runtime weight (analyzer-only, ReferenceOutputAssembly=false). -->
    <ProjectReference Include="..\Excalibur.Data.Analyzers\Excalibur.Data.Analyzers.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <!-- BUNDLE the analyzer DLL into this package at analyzers/dotnet/cs (the Microsoft pattern, as
         System.Text.Json bundles its generator) so EXDATA001-002 auto-flow to consumers of
         Excalibur.Data.Abstractions. This package is the correct carrier because it is the one that
         defines DataRequestBase and [NoTenantTerm] — an analyzer about them must travel with them or it
         protects only this repository.
         ONE delivery path: this package carries its own copy; do NOT also add a package dependency on a
         standalone analyzer package (double delivery = duplicate diagnostics). The ProjectReference above
         builds the analyzer before pack, so this output DLL exists. -->
    <None Include="..\Excalibur.Data.Analyzers\bin\$(Configuration)\netstandard2.0\Excalibur.Data.Analyzers.dll"
          Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
  </ItemGroup>
  <!-- Development mode: Dispatch ProjectReferences -->
  <ItemGroup Condition="'$(UsePackageReferences)' != 'true'">
    <ProjectReference Include="..\..\Dispatch\Excalibur.Dispatch.Abstractions\Excalibur.Dispatch.Abstractions.csproj" />
  </ItemGroup>
  <!-- PublicAPI baseline files for breaking change detection -->
  <!-- CI mode: PackageReference for Dispatch packages -->
  <ItemGroup Condition="'$(UsePackageReferences)' == 'true'">
    <PackageReference Include="Excalibur.Dispatch.Abstractions" VersionOverride="$(DispatchPackageVersion)" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Excalibur.Data" />
    <InternalsVisibleTo Include="Excalibur.Data.Abstractions.Tests" />
    <InternalsVisibleTo Include="Excalibur.Dispatch.Observability.Tests" />
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
  </ItemGroup>
</Project>