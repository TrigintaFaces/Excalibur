<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageId>Excalibur.Outbox.MongoDB</PackageId>
    <Description>MongoDB outbox persistence and IOutboxBuilder.UseMongoDB integration. Default driver document mapping has trimming and potential NativeAOT constraints; provider NativeAOT compatibility is not claimed.</Description>
    <PackageTags>excalibur;outbox;mongodb;cloud-native;event-sourcing;messaging</PackageTags>
    <!-- Default BSON mapping depends on runtime metadata and generic serializer construction. Provider NativeAOT compatibility remains unverified. -->
    <IsAotCompatible>false</IsAotCompatible>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Excalibur.Data.MongoDB.Tests" />
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" PublicKey="" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Excalibur.Data.MongoDB\Excalibur.Data.MongoDB.csproj" />
    <ProjectReference Include="..\Excalibur.Outbox\Excalibur.Outbox.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Declared directly, not inherited transitively: this package's public surface names
         MongoDB.Driver.IMongoClient (IMongoDBOutboxBuilder.Client/ClientFactory and the
         MongoDbOutboxStore constructor), so the driver is a direct dependency of the contract,
         not an implementation detail of a package we reference. -->
    <PackageReference Include="MongoDB.Driver" />
  </ItemGroup>
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
