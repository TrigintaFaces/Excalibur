<Project>
	<!-- ============================================================================================
       Sprint 325 T0.2: Project Classification Metadata (AD-325-2)
       ============================================================================================
       All projects under src/ are classified as "Shipping" by default.
       - IsPackable=true (NuGet package generation enabled)
       - IsShippingProject=true (custom marker for CI validation)
       ============================================================================================ -->
	<PropertyGroup>
		<IsPackable>true</IsPackable>
		<IsShippingProject>true</IsShippingProject>
		<ProjectClassification>Shipping</ProjectClassification>

		<!-- Restore writes packages.lock.json, recording the resolved TRANSITIVE closure. Central
		     Package Management pins DIRECT versions; only a lock file records what the transitive
		     graph resolved to, which is what makes a published package reproducible.

		     DUPLICATED from the repository-root Directory.Build.props rather than imported: this
		     file does not chain to the root (no GetPathOfFileAbove import), and adding one would
		     pull in 25 properties to obtain this one, several of them Visual-Studio build settings
		     that have no business applying to shipping projects. Duplicating the single property
		     is the smaller change. If the root copy is ever edited, edit this one too. -->
		<RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
	</PropertyGroup>

	<PropertyGroup>
		<!-- Compiler Settings -->
		<LangVersion>latest</LangVersion>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<!-- ============================================================================================
         Multi-Targeting Visual Studio Fix (Sprint 376)
         ============================================================================================
         VS has race conditions when building multiple TFMs in parallel. These settings:
         1. DisableFastUpToDateCheck - Prevents VS from using stale references
         2. ProduceReferenceAssembly - Required for proper multi-TFM dependency resolution
         3. CompileUsingReferenceAssemblies - DISABLED to fix CS0006 errors in VS
         4. Standard output paths (NOT UseArtifactsOutput) for VS compatibility
         ============================================================================================ -->
		<DisableFastUpToDateCheck Condition="'$(BuildingInsideVisualStudio)' == 'true'">true</DisableFastUpToDateCheck>
		<ProduceReferenceAssembly>true</ProduceReferenceAssembly>
		<!-- CRITICAL: Disable reference assembly compilation to fix CS0006 in VS multi-targeting -->
		<CompileUsingReferenceAssemblies>false</CompileUsingReferenceAssemblies>

		<!-- Code Quality - R0.8 Requirement -->
		<TreatWarningsAsErrors>true</TreatWarningsAsErrors>
		<WarningLevel>9999</WarningLevel>
		<EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
		<EnableNETAnalyzers>true</EnableNETAnalyzers>
		<AnalysisLevel>latest</AnalysisLevel>

		<!-- Documentation -->
		<GenerateDocumentationFile>true</GenerateDocumentationFile>

		<!-- AOT Compatibility -->
		<IsAotCompatible>true</IsAotCompatible>
		<IsTrimmable>true</IsTrimmable>

		<!-- Deterministic Builds -->
		<DeterministicSourcePaths>true</DeterministicSourcePaths>
		<EmbedUntrackedSources>true</EmbedUntrackedSources>
		<ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>

		<!-- Source Link -->
		<PublishRepositoryUrl>true</PublishRepositoryUrl>
		<IncludeSymbols>true</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>

		<!-- NuGet Pack Output - Standard paths for VS compatibility -->
		<PackageOutputPath>$(MSBuildThisFileDirectory)../artifacts/packages</PackageOutputPath>

		<!-- ============================================================================================
         Sprint 318 T3.1: Multi-License Stack (AD-318-1)
         ============================================================================================
         License stack: Excalibur 1.0, AGPL-3.0-or-later, SSPL-1.0, Apache-2.0
         Using PackageLicenseFile instead of PackageLicenseExpression because:
         - Excalibur License 1.0 is not a standard SPDX identifier
         - NuGet PackageLicenseExpression requires valid SPDX expression
         - PackageLicenseFile includes full LICENSE in package
         ============================================================================================ -->
		<PackageLicenseFile>LICENSE</PackageLicenseFile>
		<PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>
		<PackageReadmeFile>README.md</PackageReadmeFile>

		<!-- Package Metadata - R0.4 Requirement -->
		<!-- Version computed by MinVer from git tags (Polly pattern).
		     Tag format: v10.0.0-alpha.1 → PackageVersion 10.0.0-alpha.1
		     Commits after tag auto-increment: 10.0.0-alpha.2, .3, etc.
		     Local dev below the floor: 10.0.0-alpha.0.<height>
		     Release: git tag v10.0.0 → 10.0.0
		     CI override still works: -p:MinVerVersionOverride=X.Y.Z

		     The floor is 10.0 because package versions MATCH THE TARGETED .NET MAJOR: a consumer
		     reads the package version and knows the runtime it targets, with no ambiguity. The
		     framework single-targets net10.0, so the first stable version is 10.x. When the dev line
		     moves to net11.0, this floor moves with it — it is not a number to leave behind.

		     The tag remains authoritative: MinVer derives from it, and this floor only applies when
		     the derived version would fall BELOW it. Measured when it was raised from 3.0: the same
		     commit went from 3.0.0-alpha.216.2439 to 10.0.0-alpha.0.2439, which is the intent —
		     pre-10 tags no longer set the version, and they should not. -->
		<MinVerTagPrefix>v</MinVerTagPrefix>
		<MinVerMinimumMajorMinor>10.0</MinVerMinimumMajorMinor>
		<MinVerDefaultPreReleaseIdentifiers>alpha.0</MinVerDefaultPreReleaseIdentifiers>
		<Authors>The Excalibur Project Contributors</Authors>
		<Product>Excalibur</Product>
		<Copyright>Copyright (c) 2026 The Excalibur Project</Copyright>
		<!-- Consumer-visible package identity. This file does NOT import the repository-root
		     Directory.Build.props (MSBuild takes the nearest file and does not merge), so every
		     package-facing property must be declared here or it never reaches a shipping package.
		     These four were declared only at the root and therefore never shipped: nuget.org showed
		     no project website, no icon and no release notes, and RepositoryUrl fell through to
		     SourceLink's git-origin value, which names the private source repository rather than
		     the public one consumers are given. An explicit RepositoryUrl takes precedence over
		     PublishRepositoryUrl, so declaring it here is what corrects the shipped link. -->
		<PackageProjectUrl>https://github.com/TrigintaFaces/Excalibur</PackageProjectUrl>
		<RepositoryUrl>https://github.com/TrigintaFaces/Excalibur</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageReleaseNotes>See CHANGELOG.md for release notes</PackageReleaseNotes>
		<PackageIcon>icon.png</PackageIcon>
		<!-- Banned API analyzer policy -->
		<EnableBannedApiAnalyzers Condition="'$(EnableBannedApiAnalyzers)' == ''">true</EnableBannedApiAnalyzers>
		<BannedApiStrict Condition="'$(BannedApiStrict)' == ''">false</BannedApiStrict>
		<BannedSymbolsFile Condition="'$(BannedSymbolsFile)' == ''">$(MSBuildThisFileDirectory)..\eng\banned\BannedSymbols.txt</BannedSymbolsFile>
	</PropertyGroup>

	<!-- LICENSE inclusion is centralized in Directory.Build.targets (AD-320-1)
	     Suppress NU5118 (duplicate file warning) for pack stability
	     CA1873 (logging arg evaluation) — Sprint 565: fixed in Compliance/Dispatch core, remaining in transport packages -->
	<PropertyGroup>
		<!-- RS0016: Public API tracking ENABLED (Sprint 643). PublicAPI.Shipped.txt baselines populated.
		     New public API additions will trigger RS0016 warnings requiring explicit declaration.
		     RS0027: Optional parameter backcompat, alpha consumers expect breaking changes.
		     RS0041: Oblivious reference types in System.Text.Json source generated code (uncontrollable). -->
		<!-- CA1812: Internal class never instantiated — false positive for DI-registered types (IValidateOptions, health checks, etc.)
			     CA1859: Use concrete types when possible — perf optimization suggestion, not correctness; causes excessive churn in interface-heavy framework code
			     See: https://learn.microsoft.com/dotnet/fundamentals/code-analysis/quality-rules/ca1812#when-to-suppress-warnings -->
			<!-- CA1823: Unused private field — overlaps with IDE0052, tracked for incremental cleanup
			     CA1711: Identifier suffix — false positive for domain types (EventArgs, Queue, EventHandler) -->
			<!-- NU1510: net10 SDK package-pruning hint (informational; package cleanup tracked by Workstream B of S797) -->
			<NoWarn>$(NoWarn);NU5118;CA1873;RS0027;RS0041;CA1812;CA1859;CA1823;CA1711;NU1510</NoWarn>
		<!-- RS0016/RS0017: Treated as errors (via TreatWarningsAsErrors) to enforce public API baseline accuracy -->
	</PropertyGroup>
	<ItemGroup Condition="'$(IsPackable)' != 'false' And Exists('$(MSBuildProjectDirectory)\README.md')">
		<None Include="$(MSBuildProjectDirectory)\README.md" Pack="true" PackagePath="/" Visible="false" />
	</ItemGroup>

	<!-- Ship a provider's schema scripts inside its package. A store that queries a table it never gives the
	     consumer a way to create is unusable out of the box, so packaging is not optional for these files.
	     Declared centrally rather than per-project: any package that grows a Scripts directory is covered
	     without a second edit, which is the only way this stays true as providers are added. -->
	<ItemGroup Condition="'$(IsPackable)' != 'false' And Exists('$(MSBuildProjectDirectory)\Scripts')">
		<None Include="$(MSBuildProjectDirectory)\Scripts\**\*.sql" Pack="true" PackagePath="scripts\" />
	</ItemGroup>

	<!-- MinVer: git-tag-driven versioning for shipping packages (Polly pattern).
	     Excluded from projects that opt out of CPM (e.g., SourceGenerators which pins Roslyn SDK). -->
	<ItemGroup Condition="'$(IsPackable)' != 'false' And '$(ManagePackageVersionsCentrally)' != 'false'">
		<PackageReference Include="MinVer" PrivateAssets="all" />
	</ItemGroup>

	<ItemGroup Condition="'$(EnableBannedApiAnalyzers)' == 'true'">
		<PackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" PrivateAssets="all" />
	</ItemGroup>

	<ItemGroup Condition="'$(EnableBannedApiAnalyzers)' == 'true' And Exists('$(BannedSymbolsFile)')">
		<AdditionalFiles Include="$(BannedSymbolsFile)" Link="BannedSymbols.txt" Visible="false" />
	</ItemGroup>

	<PropertyGroup Condition="'$(EnableBannedApiAnalyzers)' == 'true' And '$(BannedApiStrict)' != 'true'">
		<WarningsNotAsErrors>$(WarningsNotAsErrors);RS0030</WarningsNotAsErrors>
	</PropertyGroup>

	<PropertyGroup Condition="'$(EnableBannedApiAnalyzers)' == 'true' And '$(BannedApiStrict)' == 'true'">
		<WarningsAsErrors>$(WarningsAsErrors);RS0030</WarningsAsErrors>
	</PropertyGroup>

	<!-- Public API surface tracking for breaking change detection (RS0016/RS0017) -->
	<ItemGroup>
		<PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" />
	</ItemGroup>

	<!-- PublicAPI.Shipped.txt / PublicAPI.Unshipped.txt are auto-registered as AdditionalFiles
	     by Microsoft.CodeAnalysis.PublicApiAnalyzers 3.3.4+ targets. Do NOT add them manually
	     here — doing so causes "Duplicate source file" warnings during docfx metadata extraction. -->
</Project>
