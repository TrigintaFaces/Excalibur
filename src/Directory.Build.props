<Project>
	<!-- ============================================================================================
       Project Classification Metadata
       ============================================================================================
       All projects under src/ are classified as "Shipping" by default.
       - IsPackable=true (NuGet package generation enabled)
       - IsShippingProject=true (custom marker for CI validation)
       ============================================================================================ -->
	<PropertyGroup>
		<IsPackable>true</IsPackable>
		<IsShippingProject>true</IsShippingProject>
		<ProjectClassification>Shipping</ProjectClassification>

		<!-- Restore writes packages.lock.json, recording the resolved TRANSITIVE closure. Central
		     Package Management pins DIRECT versions; only a lock file records what the transitive
		     graph resolved to, which is what makes a published package reproducible.

		     DUPLICATED from the repository-root Directory.Build.props rather than imported: this
		     file does not chain to the root (no GetPathOfFileAbove import), and adding one would
		     pull in 25 properties to obtain this one, several of them Visual-Studio build settings
		     that have no business applying to shipping projects. Duplicating the single property
		     is the smaller change. If the root copy is ever edited, edit this one too. -->
		<RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
	</PropertyGroup>

	<PropertyGroup>
		<!-- Compiler Settings -->
		<LangVersion>latest</LangVersion>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<!-- ============================================================================================
         Multi-Targeting Visual Studio Fix
         ============================================================================================
         VS has race conditions when building multiple TFMs in parallel. These settings:
         1. DisableFastUpToDateCheck - Prevents VS from using stale references
         2. ProduceReferenceAssembly - Required for proper multi-TFM dependency resolution
         3. CompileUsingReferenceAssemblies - DISABLED to fix CS0006 errors in VS
         4. Standard output paths (NOT UseArtifactsOutput) for VS compatibility
         ============================================================================================ -->
		<DisableFastUpToDateCheck Condition="'$(BuildingInsideVisualStudio)' == 'true'">true</DisableFastUpToDateCheck>
		<ProduceReferenceAssembly>true</ProduceReferenceAssembly>
		<!-- CRITICAL: Disable reference assembly compilation to fix CS0006 in VS multi-targeting -->
		<CompileUsingReferenceAssemblies>false</CompileUsingReferenceAssemblies>

		<!-- Code Quality -->
		<TreatWarningsAsErrors>true</TreatWarningsAsErrors>
		<WarningLevel>9999</WarningLevel>
		<EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
		<EnableNETAnalyzers>true</EnableNETAnalyzers>
		<AnalysisLevel>latest</AnalysisLevel>

		<!-- Documentation -->
		<GenerateDocumentationFile>true</GenerateDocumentationFile>

		<!-- AOT Compatibility.
		     OPT-IN, not inherited. IsAotCompatible is a promise a consumer reads: it says ILC can prove
		     this package's reflection paths safe under trimming. A default of `true` makes that promise
		     on a package's behalf, and a package that later takes a reflecting dependency keeps the
		     promise automatically while it stops being true.
		     That is not hypothetical. Excalibur.Compliance.Pdf's own csproj states "AOT status of the
		     PDF export path is UNVERIFIED ... IsAotCompatible is deliberately not set here for that
		     reason" - and the inherited default resolved it to `true` anyway, publishing the claim its
		     author had explicitly declined to make.
		     Cost of this default is ~zero: 164 projects declare `true` explicitly and 45 declare
		     `false` explicitly, and an explicit value always wins over the default, so only the single
		     project that was relying on inheritance changes - to what its own comment already says.
		     Setting this to `true` on a package should follow evidence, not convention:
		     eng/ci/Invoke-AotCoverageGate.ps1 publishes a package under ILC and reports what it finds. -->
		<IsAotCompatible>false</IsAotCompatible>
		<!-- Trimmability is DERIVED, never asserted by convention.
		     IsTrimmable=true emits an assembly attribute telling a consumer's trimmer it is safe to trim
		     this package's code. Setting it for every project by default made that promise on behalf of
		     packages that had never been analysed - the same defect fixed one property above for the
		     ahead-of-time claim, still live one line below it.
		     It is not set here. A project declaring IsAotCompatible=true gets IsTrimmable=true derived by
		     the SDK, because ahead-of-time compatibility implies trimmability; the converse does not hold
		     and the SDK deliberately does not derive it. So the claim now follows the evidence.
		     The ANALYZER is kept on unconditionally below. Dropping the claim must not drop the analysis -
		     that trade buys honest metadata by going blind, and blind is how the metadata drifted. -->
		<EnableTrimAnalyzer>true</EnableTrimAnalyzer>
		<!-- The trim analyzer above covers the IL2xxx codes only. The dynamic-code codes IL3050/IL3051
		     come from a SEPARATE analyzer, which the SDK derives from IsAotCompatible=true - so every
		     project that honestly declared `false` above thereby switched dynamic-code detection off.
		     That is the going-blind the paragraph above exists to prevent, still live one property later.
		     Enabled here unconditionally and independently of the claim: a package may be unable to
		     promise ahead-of-time compatibility and still need to know the moment it acquires a new
		     reflective path. A project the analyzer genuinely cannot serve - a netstandard Roslyn
		     component - sets false in its own csproj, which wins over this default. -->
		<EnableAotAnalyzer>true</EnableAotAnalyzer>

		<!-- Deterministic Builds -->
		<DeterministicSourcePaths>true</DeterministicSourcePaths>
		<EmbedUntrackedSources>true</EmbedUntrackedSources>
		<ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>

		<!-- Source Link -->
		<PublishRepositoryUrl>true</PublishRepositoryUrl>
		<IncludeSymbols>true</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>

		<!-- NuGet Pack Output - Standard paths for VS compatibility -->
		<PackageOutputPath>$(MSBuildThisFileDirectory)../artifacts/packages</PackageOutputPath>

		<!-- ============================================================================================
         Multi-License Stack
         ============================================================================================
         License stack: Excalibur 1.0, AGPL-3.0-or-later, SSPL-1.0, Apache-2.0
         Using PackageLicenseFile instead of PackageLicenseExpression because:
         - Excalibur License 1.0 is not a standard SPDX identifier
         - NuGet PackageLicenseExpression requires valid SPDX expression
         - PackageLicenseFile includes full LICENSE in package
         ============================================================================================ -->
		<PackageLicenseFile>LICENSE</PackageLicenseFile>
		<PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>
		<PackageReadmeFile>README.md</PackageReadmeFile>

		<!-- Package Metadata -->
		<!-- Version computed by MinVer from git tags (Polly pattern).
		     Tag format: v10.0.0-alpha.1 → PackageVersion 10.0.0-alpha.1
		     Commits after tag auto-increment: 10.0.0-alpha.2, .3, etc.
		     Local dev below the floor: 10.0.0-alpha.0.<height>
		     Release: git tag v10.0.0 → 10.0.0
		     CI override still works: -p:MinVerVersionOverride=X.Y.Z

		     The floor is 10.0 because package versions MATCH THE TARGETED .NET MAJOR: a consumer
		     reads the package version and knows the runtime it targets, with no ambiguity. The
		     framework single-targets net10.0, so the first stable version is 10.x. When the dev line
		     moves to net11.0, this floor moves with it — it is not a number to leave behind.

		     The tag remains authoritative: MinVer derives from it, and this floor only applies when
		     the derived version would fall BELOW it. Measured when it was raised from 3.0: the same
		     commit went from 3.0.0-alpha.216.2439 to 10.0.0-alpha.0.2439, which is the intent —
		     pre-10 tags no longer set the version, and they should not. -->
		<MinVerTagPrefix>v</MinVerTagPrefix>
		<MinVerMinimumMajorMinor>10.0</MinVerMinimumMajorMinor>
		<MinVerDefaultPreReleaseIdentifiers>alpha.0</MinVerDefaultPreReleaseIdentifiers>
		<Authors>The Excalibur Project Contributors</Authors>
		<Product>Excalibur</Product>
		<Copyright>Copyright (c) 2026 The Excalibur Project</Copyright>
		<!-- Consumer-visible package identity. This file does NOT import the repository-root
		     Directory.Build.props (MSBuild takes the nearest file and does not merge), so every
		     package-facing property must be declared here or it never reaches a shipping package.
		     These four were declared only at the root and therefore never shipped: nuget.org showed
		     no project website, no icon and no release notes, and RepositoryUrl fell through to
		     SourceLink's git-origin value, which names the private source repository rather than
		     the public one consumers are given. An explicit RepositoryUrl takes precedence over
		     PublishRepositoryUrl, so declaring it here is what corrects the shipped link. -->
		<PackageProjectUrl>https://github.com/TrigintaFaces/Excalibur</PackageProjectUrl>
		<RepositoryUrl>https://github.com/TrigintaFaces/Excalibur</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<!-- A bare filename is not a route: a consumer reads this field on a package listing, where
		     there is no repository checkout to open. The versioning policy page states the release
		     stages and what each one promises about API stability, and it is reachable from the
		     listing itself. -->
		<PackageReleaseNotes>Release notes and versioning policy: https://docs.excalibur-dispatch.dev/docs/migration/version-upgrades</PackageReleaseNotes>
		<PackageIcon>icon.png</PackageIcon>

		<!-- The pre-release warning belongs in the package's own description, not only in the
		     documentation. The SemVer pre-release suffix is the canonical machine-readable signal and
		     it already does its job: such packages are flagged in the gallery UI and are excluded
		     from default resolution unless the consumer opts in. What the suffix cannot carry is what
		     the instability actually means for someone who has already opted in and is reading the
		     description to decide whether to adopt.
		
		     Set here rather than in 199 project files so it cannot be declared inconsistently, and
		     appended by the target in Directory.Build.targets rather than written into each
		     description, so no project can carry the notice without carrying the version that
		     justifies it. -->
		<PreReleaseNotice>PRE-RELEASE: the public API is not frozen and may change between pre-release builds. Not recommended for production use. Known issues: https://docs.excalibur-dispatch.dev/docs/known-issues</PreReleaseNotice>
		<!-- Banned API analyzer policy -->
		<EnableBannedApiAnalyzers Condition="'$(EnableBannedApiAnalyzers)' == ''">true</EnableBannedApiAnalyzers>
		<BannedApiStrict Condition="'$(BannedApiStrict)' == ''">false</BannedApiStrict>
		<BannedSymbolsFile Condition="'$(BannedSymbolsFile)' == ''">$(MSBuildThisFileDirectory)..\eng\banned\BannedSymbols.txt</BannedSymbolsFile>
	</PropertyGroup>

	<!-- LICENSE inclusion is centralized in Directory.Build.targets
	     Suppress NU5118 (duplicate file warning) for pack stability
	     CA1873 (logging arg evaluation) — fixed in Compliance/Dispatch core, remaining in transport packages -->
	<PropertyGroup>
		<!-- RS0016: Public API tracking ENABLED. PublicAPI.Shipped.txt baselines populated.
		     New public API additions will trigger RS0016 warnings requiring explicit declaration.
		     RS0027: Optional parameter backcompat, alpha consumers expect breaking changes.
		     RS0041: Oblivious reference types in System.Text.Json source generated code (uncontrollable). -->
		<!-- CA1812: Internal class never instantiated. Suppressed on a MEASURED false-positive rate, not an
			     assertion. Census of all 405 solution projects with CA1812 un-suppressed: 635 hits — 14 in src,
			     608 in tests, 13 in samples. Every one of the 14 src hits was checked individually against its
			     registration site and all 14 are DI-registered (12 via ServiceDescriptor.Singleton<IValidateOptions<T>,…>
			     or TryAddSingleton<TService,TImpl>, one activity registered through AddActivity<T,…>). The rate in
			     src is 14/14 — the analyzer cannot see container construction, so it finds no real dead type here and
			     re-arming it for any subset of packages buys nothing. The test and sample hits are handler/middleware
			     doubles instantiated by the dispatcher's own reflection, the same blind spot. Re-measure before changing
			     this: the justification is the number, and the number can move.
			     CA1859: Use concrete types when possible — perf optimization suggestion, not correctness; causes excessive churn in interface-heavy framework code
			     See: https://learn.microsoft.com/dotnet/fundamentals/code-analysis/quality-rules/ca1812#when-to-suppress-warnings -->
			<!-- CA1823: Unused private field — SUPPRESSION REMOVED (from this list and from the identical list
			     in tests/Directory.Build.props). The reason originally given was overlap with IDE0052, which does
			     not hold: IDE0052 reports a private member ASSIGNED and never read, CA1823 reports a field never
			     REFERENCED at all — disjoint populations — and tests/Directory.Build.props sets
			     EnforceCodeStyleInBuild=false, so IDE0052 never ran on the test tree at all.
			     The census recorded here previously read '38 distinct hits, 8 src / 30 tests' and said removal was
			     blocked on triaging them. THAT NUMBER WAS STALE. Re-measured across the whole solution — 209 src and
			     100 test projects, CA1823 forced to warning so the build COMPLETED rather than stopping at the first
			     error, exit 0 with zero build errors — the real population was ONE: a superseded duplicate-key
			     constant in Excalibur.Inbox.MongoDB, removed in the same change as this line.
			     The near-zero was only accepted after a positive control planted in the TEST tree confirmed an unused
			     private field there does fire CA1823 — that subtree held 30 of the claimed 38, and a subtree that
			     never compiled reports the same clean zero as a genuinely clean one.
			     What caught this was the re-measure instruction on CA1812 above, firing in the opposite direction from
			     the one it was written for. Trust that instruction over any figure in this file, including these:
			     a count is only as good as its last measurement.
			     CA1711: Identifier suffix — false positive for domain types (EventArgs, Queue, EventHandler) -->
			<!-- NU1510: net10 SDK package-pruning hint (informational; package cleanup) -->
			<NoWarn>$(NoWarn);NU5118;CA1873;RS0027;RS0041;CA1812;CA1859;CA1711;NU1510</NoWarn>
		<!-- RS0016/RS0017: Treated as errors (via TreatWarningsAsErrors) to enforce public API baseline accuracy -->
	</PropertyGroup>
	<ItemGroup Condition="'$(IsPackable)' != 'false' And Exists('$(MSBuildProjectDirectory)\README.md')">
		<None Include="$(MSBuildProjectDirectory)\README.md" Pack="true" PackagePath="/" Visible="false" />
	</ItemGroup>

	<!-- Ship a provider's schema scripts inside its package. A store that queries a table it never gives the
	     consumer a way to create is unusable out of the box, so packaging is not optional for these files.
	     Declared centrally rather than per-project: any package that grows a Scripts directory is covered
	     without a second edit, which is the only way this stays true as providers are added. -->
	<ItemGroup Condition="'$(IsPackable)' != 'false' And Exists('$(MSBuildProjectDirectory)\Scripts')">
		<None Include="$(MSBuildProjectDirectory)\Scripts\**\*.sql" Pack="true" PackagePath="scripts\" />
	</ItemGroup>

	<!-- MinVer: git-tag-driven versioning for shipping packages (Polly pattern).
	
	     TWO groups, because a shipping package must not be able to fall off the version line.
	     MinVer arrives as a PackageReference, and a versionless reference is an error when a
	     project opts out of central package management, so the first group is conditioned on CPM
	     being enabled. That condition used to be the whole story, and it quietly turned a build
	     accommodation into a versioning decision: a packable project that pins its own dependencies
	     received no MinVer at all and fell back to the SDK default. Four packages shipped at 1.0.0
	     while the other 579 were on the 10.x line, and nothing said so, because tagged releases stamp every
	     project alike, so the skew was only ever visible on builds nobody reads a version off.
	
	     The second group is the opt-out path, supplying the version inline. Both take it from one
	     property: a literal in two files is a value that drifts, which is this same defect one level
	     up. Note the MinVer PROPERTIES above are unconditional and always applied; only the
	     reference was ever missing, which is why a project could look configured and still not be.
	
	     Enforced rather than remembered: the official build refuses to publish a package set
	     carrying more than one version, which is how the 1.0.0 packages were found. -->
	<PropertyGroup>
		<MinVerPackageVersion>6.0.0</MinVerPackageVersion>
	</PropertyGroup>
	<ItemGroup Condition="'$(IsPackable)' != 'false' And '$(ManagePackageVersionsCentrally)' != 'false'">
		<PackageReference Include="MinVer" PrivateAssets="all" />
	</ItemGroup>
	<ItemGroup Condition="'$(IsPackable)' != 'false' And '$(ManagePackageVersionsCentrally)' == 'false'">
		<PackageReference Include="MinVer" Version="$(MinVerPackageVersion)" PrivateAssets="all" />
	</ItemGroup>

	<ItemGroup Condition="'$(EnableBannedApiAnalyzers)' == 'true'">
		<PackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" PrivateAssets="all" />
	</ItemGroup>

	<ItemGroup Condition="'$(EnableBannedApiAnalyzers)' == 'true' And Exists('$(BannedSymbolsFile)')">
		<AdditionalFiles Include="$(BannedSymbolsFile)" Link="BannedSymbols.txt" Visible="false" />
	</ItemGroup>

	<PropertyGroup Condition="'$(EnableBannedApiAnalyzers)' == 'true' And '$(BannedApiStrict)' != 'true'">
		<WarningsNotAsErrors>$(WarningsNotAsErrors);RS0030</WarningsNotAsErrors>
	</PropertyGroup>

	<!-- IDE0052 (private member assigned and never read) is armed as a warning in .editorconfig. It is
	     held out of TreatWarningsAsErrors while the population measured at the moment it was re-armed
	     is worked down: eng/ci/ide0052-baseline.txt is the frozen ledger and
	     eng/ci/ide0052-ratchet-gate.sh fails any site not already in it, so the count can only shrink.
	     Set Ide0052Strict=true to promote it to a hard error; delete this block once the ledger is
	     empty. Mirrors the BannedApiStrict toggle above. -->
	<PropertyGroup Condition="'$(Ide0052Strict)' != 'true'">
		<WarningsNotAsErrors>$(WarningsNotAsErrors);IDE0052</WarningsNotAsErrors>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Ide0052Strict)' == 'true'">
		<WarningsAsErrors>$(WarningsAsErrors);IDE0052</WarningsAsErrors>
	</PropertyGroup>

	<PropertyGroup Condition="'$(EnableBannedApiAnalyzers)' == 'true' And '$(BannedApiStrict)' == 'true'">
		<WarningsAsErrors>$(WarningsAsErrors);RS0030</WarningsAsErrors>
	</PropertyGroup>

	<!-- Public API surface tracking for breaking change detection (RS0016/RS0017) -->
	<ItemGroup>
		<PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" />
	</ItemGroup>

	<!-- PublicAPI.Shipped.txt / PublicAPI.Unshipped.txt are auto-registered as AdditionalFiles
	     by Microsoft.CodeAnalysis.PublicApiAnalyzers 3.3.4+ targets. Do NOT add them manually
	     here — doing so causes "Duplicate source file" warnings during docfx metadata extraction. -->
</Project>
