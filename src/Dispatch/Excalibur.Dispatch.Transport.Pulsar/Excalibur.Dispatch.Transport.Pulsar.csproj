<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageId>Excalibur.Dispatch.Transport.Pulsar</PackageId>
    <Description>Apache Pulsar integration for the Excalibur framework. Provides competing-consumer message streaming over the DotPulsar client.</Description>
    <PackageTags>messaging;dispatch;pulsar;streaming;cloud;aot</PackageTags>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Excalibur.Dispatch.Abstractions\Excalibur.Dispatch.Abstractions.csproj" />
    <ProjectReference Include="..\Excalibur.Dispatch.Transport.Abstractions\Excalibur.Dispatch.Transport.Abstractions.csproj" />
    <ProjectReference Include="..\Excalibur.Dispatch\Excalibur.Dispatch.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Apache Pulsar client -->
    <PackageReference Include="DotPulsar" />
    <!-- Common dependencies -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Excalibur.Dispatch.Transport.Pulsar.Tests" />
    <InternalsVisibleTo Include="Excalibur.Dispatch.Transport.Pulsar.Tests.Unit" />
    <InternalsVisibleTo Include="Excalibur.Dispatch.Transport.Pulsar.Tests.Integration" />
    <InternalsVisibleTo Include="Excalibur.Dispatch.Transport.Pulsar.Tests.Functional" />
    <InternalsVisibleTo Include="Excalibur.Dispatch.Transport.Tests" />
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
  </ItemGroup>
</Project>
