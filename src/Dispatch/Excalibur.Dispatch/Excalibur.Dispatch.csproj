<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <CompilerGeneratedFilesOutputPath>$(BaseIntermediateOutputPath)\GeneratedFiles</CompilerGeneratedFilesOutputPath>
    <RootNamespace>Excalibur.Dispatch</RootNamespace>
    <AssemblyName>Excalibur.Dispatch</AssemblyName>
    <!-- PERF-9: Enable C# 12 interceptors for compile-time dispatch optimization -->
    <InterceptorsNamespaces>$(InterceptorsNamespaces);Excalibur.Dispatch.Generated</InterceptorsNamespaces>
    <!-- NuGet Package Metadata -->
    <PackageId>Excalibur.Dispatch</PackageId>
    <Description>Core messaging abstractions and middleware pipeline for the Excalibur framework. Provides foundational types for message handling, routing, and extensible middleware architecture.</Description>
    <PackageTags>messaging;dispatch;middleware;pipeline;cqrs;framework</PackageTags>
    <IsAotCompatible>true</IsAotCompatible>
    <!-- Bind configuration through the first-party binding source generator instead of the
         reflection-based binder, so option binding needs no runtime code generation. -->
    <EnableConfigurationBindingGenerator>true</EnableConfigurationBindingGenerator>
  </PropertyGroup>
  <!-- This framework uses reflection extensively for handler resolution, pipeline configuration,
       and dynamic dispatch. Suppress AOT/trimming warnings that are inherent to the design:
       - CS8602/CS8604: Nullable dereference in patterns proven non-null by control flow
         (TryGetValue out params, ThreadLocal.Value with factory, post-null-check paths)
       - IL2026/IL3050: ValidateDataAnnotations, Bind, and serializer calls that require reflection
       - IL2046/IL3051: Interface/impl AOT attribute mismatches (IDispatcher, IHandlerActivator, IEventSerializer)
       - IL2055: MakeGenericType for typed handler/mapper resolution
       - IL2070/IL2075/IL2095: GetInterfaces/GetProperties for pipeline and middleware configuration
  -->
  <!-- NoWarn REMOVED: all nullable/AOT warnings now fixed at source with proper annotations and suppressions -->
  <!-- Include README.md in NuGet package -->
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Update="Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
    <Compile Update="Resources.Designer.cs">
      <DesignTime>true</DesignTime>
      <AutoGen>true</AutoGen>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
  </ItemGroup>
  <!-- Enhanced AOT Configuration -->
  <PropertyGroup>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <EnableAotAnalyzer>true</EnableAotAnalyzer>
    <EnableSingleFileAnalyzer>true</EnableSingleFileAnalyzer>
    <PublishAot Condition="'$(PublishAot)' == ''">false</PublishAot>
    <TrimMode>full</TrimMode>
    <IlcOptimizationPreference>Speed</IlcOptimizationPreference>
    <IlcGenerateStackTraceData>false</IlcGenerateStackTraceData>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>
  <PropertyGroup>
    <DefineConstants>$(DefineConstants);USE_SOURCE_GENERATION</DefineConstants>
    <SuppressTrimAnalysisWarnings>false</SuppressTrimAnalysisWarnings>
    <TrimmerDefaultAction>link</TrimmerDefaultAction>
    <TrimMode>full</TrimMode>
  </PropertyGroup>
  <!-- AOT_ENABLED must only be defined when actually publishing AOT.
       Unconditionally defining it disables JIT fallback paths (assembly scanning,
       runtime type resolution) which breaks consumers running in JIT mode. -->
  <PropertyGroup Condition="'$(PublishAot)' == 'true'">
    <DefineConstants>$(DefineConstants);AOT_ENABLED</DefineConstants>
  </PropertyGroup>
  <!-- Preserve types for reflection -->
  <ItemGroup Condition="'$(PublishAot)' == 'true'">
    <TrimmerRootAssembly Include="Excalibur.Dispatch" />
    <TrimmerRootDescriptor Include="TrimmerRoots.xml" />
  </ItemGroup>
  <!-- Removed ASP.NET Core FrameworkReference to keep Core decoupled from hosting frameworks -->
  <ItemGroup>
    <!-- From Excalibur.Dispatch.Common -->
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
    <PackageReference Include="Microsoft.Extensions.Options.DataAnnotations" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.ObjectPool" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks" />
    <PackageReference Include="Microsoft.Extensions.Http" />
    <!-- Removed DB client dependencies to avoid provider coupling in Core -->
    <!-- From Excalibur.Dispatch.Messaging.Abstractions -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <!-- From Excalibur.Dispatch.Messaging -->
    <PackageReference Include="CloudNative.CloudEvents.SystemTextJson" />
    <PackageReference Include="Cronos" />
    <!-- MemoryPack removed from core; JSON is the default, binary serializers are opt-in provider packages -->
    <!-- Microsoft.ApplicationInsights removed: unused in Core (no .cs references) and its v3+ transitive graph pulls Azure.Core + Azure.Monitor.OpenTelemetry.Exporter into Core, which violates the no-provider-SDK-in-Core governance rule. Telemetry/OTel integration belongs in Excalibur.Dispatch.Observability. -->
    <!-- Polly removed - Use IRetryPolicy from Excalibur.Dispatch.Resilience or Excalibur.Dispatch.Resilience.Polly -->
    <PackageReference Include="System.Threading.Channels" />
    <PackageReference Include="System.Threading.RateLimiting" />
    <!-- System.IO.Pipelines is in-box for net10.0 (no package reference needed) -->
    <!-- Wasmtime REMOVED - No code in Dispatch uses it -->
    <!-- Database drivers REMOVED - Moved to Excalibur.Data.* provider packages -->
    <!-- FluentValidation moved to optional Excalibur.Dispatch.Validation.FluentValidation package -->
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Excalibur.Dispatch.Abstractions\Excalibur.Dispatch.Abstractions.csproj" />
    <!-- MemoryPack ProjectReference removed; opt-in via Excalibur.Dispatch.Serialization.MemoryPack package -->
    <!-- PERF-7/PERF-8: Source generators always enabled for AOT-compatible handler resolution -->
    <ProjectReference Include="..\Excalibur.Dispatch.SourceGenerators\Excalibur.Dispatch.SourceGenerators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" PrivateAssets="all" />
    <!-- Diagnostic analyzers (DISP001-006) run on this project's own build AND are bundled into this package
         (see the pack ItemGroup below), so every Excalibur.Dispatch consumer gets the message-type-contract
         diagnostics with zero extra install and zero runtime weight (analyzer-only, ReferenceOutputAssembly=false). -->
    <ProjectReference Include="..\Excalibur.Dispatch.SourceGenerators.Analyzers\Excalibur.Dispatch.SourceGenerators.Analyzers.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" PrivateAssets="all" />
    <!-- NOTE: Excalibur.Requirements.Generator reference removed to maintain architectural boundaries.
		     Requirements generation should be handled at solution level, not within individual components. -->
  </ItemGroup>
  <ItemGroup>
    <!-- BUNDLE the analyzer DLL into this package at analyzers/dotnet/cs (Microsoft pattern, as
         System.Text.Json bundles its generator) so DISP001-006 auto-flow to consumers of Excalibur.Dispatch.
         ONE delivery path: this package carries its own copy; do NOT also add a package dependency on the
         standalone analyzer package (double delivery = duplicate-diagnostic). The ProjectReference above
         builds the analyzer before pack, so this output DLL exists. -->
    <None Include="..\Excalibur.Dispatch.SourceGenerators.Analyzers\bin\$(Configuration)\netstandard2.0\Excalibur.Dispatch.SourceGenerators.Analyzers.dll"
          Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
    <!-- BUNDLE the source generator the same way, and for the same reason. Without it the
         generator runs on this project's own build but never reaches a consumer, so the typed
         DispatchAsync overload it emits does not exist in their compilation and the documented
         call shape fails to compile against the non-generic IMessageResult. Bundling it also puts
         every consumer on the zero-reflection handler-resolution path by default rather than as
         a reward for finding a second package. -->
    <None Include="..\Excalibur.Dispatch.SourceGenerators\bin\$(Configuration)\netstandard2.0\Excalibur.Dispatch.SourceGenerators.dll"
          Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
    <!-- Opts the generated interceptor namespace in for consumers. Travels with the bundled
         generator above so the two never get separated. -->
    <None Include="build\Excalibur.Dispatch.props" Pack="true" PackagePath="buildTransitive/Excalibur.Dispatch.props" />
    <None Include="build\Excalibur.Dispatch.props" Pack="true" PackagePath="build/Excalibur.Dispatch.props" />
  </ItemGroup>
  <ItemGroup>
    <Compile Update="Messaging\Resources\ErrorMessages.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>ErrorMessages.resx</DependentUpon>
    </Compile>
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Update="Messaging\Resources\ErrorMessages.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>ErrorMessages.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>
  <!-- InternalsVisibleTo for unit tests -->
  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>Excalibur.Dispatch.Tests</_Parameter1>
    </AssemblyAttribute>
    <!-- Measurement access: the writer pool is internal, and the benchmark that decides whether
         Microsoft.Extensions.ObjectPool outperforms it has to be able to construct both. -->
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>Excalibur.Dispatch.Benchmarks</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>Excalibur.Tests</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>Excalibur.Dispatch.Patterns.Tests</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>Excalibur.Dispatch.Messaging.Tests</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
