<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <CompilerGeneratedFilesOutputPath>$(BaseIntermediateOutputPath)\GeneratedFiles</CompilerGeneratedFilesOutputPath>
    <RootNamespace>Excalibur.Dispatch</RootNamespace>
    <AssemblyName>Excalibur.Dispatch</AssemblyName>
    <!-- PERF-9: Enable C# 12 interceptors for compile-time dispatch optimization -->
    <InterceptorsNamespaces>$(InterceptorsNamespaces);Excalibur.Dispatch.Generated</InterceptorsNamespaces>
    <!-- NuGet Package Metadata -->
    <PackageId>Excalibur.Dispatch</PackageId>
    <Description>Core messaging abstractions and middleware pipeline for the Excalibur framework. Provides foundational types for message handling, routing, and extensible middleware architecture.</Description>
    <PackageTags>messaging;dispatch;middleware;pipeline;cqrs;framework</PackageTags>
    <IsAotCompatible>true</IsAotCompatible>
    <!-- Bind configuration through the first-party binding source generator instead of the
         reflection-based binder, so option binding needs no runtime code generation. -->
    <EnableConfigurationBindingGenerator>true</EnableConfigurationBindingGenerator>
  </PropertyGroup>
  <!-- This framework uses reflection extensively for handler resolution, pipeline configuration,
       and dynamic dispatch. Suppress AOT/trimming warnings that are inherent to the design:
       - CS8602/CS8604: Nullable dereference in patterns proven non-null by control flow
         (TryGetValue out params, ThreadLocal.Value with factory, post-null-check paths)
       - IL2026/IL3050: ValidateDataAnnotations, Bind, and serializer calls that require reflection
       - IL2046/IL3051: Interface/impl AOT attribute mismatches (IDispatcher, IHandlerActivator, IEventSerializer)
       - IL2055: MakeGenericType for typed handler/mapper resolution
       - IL2070/IL2075/IL2095: GetInterfaces/GetProperties for pipeline and middleware configuration
  -->
  <!-- NoWarn REMOVED: all nullable/AOT warnings now fixed at source with proper annotations and suppressions -->
  <!-- Include README.md in NuGet package -->
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Update="Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
    <Compile Update="Resources.Designer.cs">
      <DesignTime>true</DesignTime>
      <AutoGen>true</AutoGen>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
  </ItemGroup>
  <!-- Enhanced AOT Configuration -->
  <PropertyGroup>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <EnableAotAnalyzer>true</EnableAotAnalyzer>
    <EnableSingleFileAnalyzer>true</EnableSingleFileAnalyzer>
    <PublishAot Condition="'$(PublishAot)' == ''">false</PublishAot>
    <TrimMode>full</TrimMode>
    <IlcOptimizationPreference>Speed</IlcOptimizationPreference>
    <IlcGenerateStackTraceData>false</IlcGenerateStackTraceData>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>
  <PropertyGroup>
    <DefineConstants>$(DefineConstants);USE_SOURCE_GENERATION</DefineConstants>
    <SuppressTrimAnalysisWarnings>false</SuppressTrimAnalysisWarnings>
    <TrimmerDefaultAction>link</TrimmerDefaultAction>
    <TrimMode>full</TrimMode>
  </PropertyGroup>
  <!-- AOT_ENABLED must only be defined when actually publishing AOT.
       Unconditionally defining it disables JIT fallback paths (assembly scanning,
       runtime type resolution) which breaks consumers running in JIT mode. -->
  <PropertyGroup Condition="'$(PublishAot)' == 'true'">
    <DefineConstants>$(DefineConstants);AOT_ENABLED</DefineConstants>
  </PropertyGroup>
  <!-- Preserve types for reflection -->
  <ItemGroup Condition="'$(PublishAot)' == 'true'">
    <TrimmerRootAssembly Include="Excalibur.Dispatch" />
    <TrimmerRootDescriptor Include="TrimmerRoots.xml" />
  </ItemGroup>
  <!-- Removed ASP.NET Core FrameworkReference to keep Core decoupled from hosting frameworks -->
  <ItemGroup>
    <!-- From Excalibur.Dispatch.Common -->
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
    <PackageReference Include="Microsoft.Extensions.Options.DataAnnotations" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.ObjectPool" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks" />
    <PackageReference Include="Microsoft.Extensions.Http" />
    <!-- Removed DB client dependencies to avoid provider coupling in Core -->
    <!-- From Excalibur.Dispatch.Messaging.Abstractions -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <!-- From Excalibur.Dispatch.Messaging -->
    <PackageReference Include="CloudNative.CloudEvents.SystemTextJson" />
    <PackageReference Include="Cronos" />
    <!-- MemoryPack removed from core; JSON is the default, binary serializers are opt-in provider packages -->
    <!-- Microsoft.ApplicationInsights removed: unused in Core (no .cs references) and its v3+ transitive graph pulls Azure.Core + Azure.Monitor.OpenTelemetry.Exporter into Core, which violates the no-provider-SDK-in-Core governance rule. Telemetry/OTel integration belongs in Excalibur.Dispatch.Observability. -->
    <!-- Polly removed - Use IRetryPolicy from Excalibur.Dispatch.Resilience or Excalibur.Dispatch.Resilience.Polly -->
    <PackageReference Include="System.Threading.Channels" />
    <PackageReference Include="System.Threading.RateLimiting" />
    <!-- System.IO.Pipelines is in-box for net10.0 (no package reference needed) -->
    <!-- Wasmtime REMOVED - No code in Dispatch uses it -->
    <!-- Database drivers REMOVED - Moved to Excalibur.Data.* provider packages -->
    <!-- FluentValidation moved to optional Excalibur.Dispatch.Validation.FluentValidation package -->
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Excalibur.Dispatch.Abstractions\Excalibur.Dispatch.Abstractions.csproj" />
    <!-- MemoryPack ProjectReference removed; opt-in via Excalibur.Dispatch.Serialization.MemoryPack package -->
    <!-- PERF-7/PERF-8: Source generators always enabled for AOT-compatible handler resolution -->
    <ProjectReference Include="..\Excalibur.Dispatch.SourceGenerators\Excalibur.Dispatch.SourceGenerators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" PrivateAssets="all" />
    <!-- Diagnostic analyzers (DISP001-006) run on this project's own build AND are bundled into this package
         (see the pack ItemGroup below), so every Excalibur.Dispatch consumer gets the message-type-contract
         diagnostics with zero extra install and zero runtime weight (analyzer-only, ReferenceOutputAssembly=false). -->
    <ProjectReference Include="..\Excalibur.Dispatch.SourceGenerators.Analyzers\Excalibur.Dispatch.SourceGenerators.Analyzers.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" PrivateAssets="all" />
    <!-- NOTE: Excalibur.Requirements.Generator reference removed to maintain architectural boundaries.
		     Requirements generation should be handled at solution level, not within individual components. -->
  </ItemGroup>
  <ItemGroup>
    <!-- Opts the generated interceptor namespace in for consumers. Travels with the bundled
         generator below so the two never get separated. -->
    <None Include="build\Excalibur.Dispatch.props" Pack="true" PackagePath="buildTransitive/Excalibur.Dispatch.props" />
    <None Include="build\Excalibur.Dispatch.props" Pack="true" PackagePath="build/Excalibur.Dispatch.props" />
  </ItemGroup>
  <!-- BUNDLE the analyzer + source-generator DLLs into this package at analyzers/dotnet/cs (Microsoft
       pattern, as System.Text.Json bundles its generator) so DISP001-006 and the typed-invoke codegen
       auto-flow to consumers of Excalibur.Dispatch, with zero extra install. ONE delivery path: this
       package carries its own copy; do NOT also add a package dependency on the standalone analyzer
       package (double delivery = duplicate-diagnostic).

       Sourced from @(Analyzer), the item MSBuild itself populated by resolving the two
       OutputItemType="Analyzer" ProjectReferences above, rather than a hardcoded
       "bin\$(Configuration)\netstandard2.0\*.dll" literal. A literal path silently stops matching (and the
       pack ships WITHOUT the analyzer, no error) the moment either project's TFM or output layout changes;
       @(Analyzer) is resolved by the same build that is about to consume it, so it cannot go stale that way.
       The trailing Error additionally fails the pack loudly if resolution ever comes back empty, so a
       genuinely broken reference can't ship silently either. -->
  <!-- ResolveProjectReferences below invokes the DEFAULT targets (Build) on every ProjectReference.
       Under a no-build pack the SDK sets NoBuild=true and errors NETSDK1085 the moment any project's
       Build target is entered, so the official pack step died on Excalibur.Dispatch.Abstractions, a
       project this one only reads a path from. BuildProjectReferences=false makes the resolution ask
       references for GetTargetPath instead of building them, which is all @(Analyzer) needs and is what
       a no-build pack already promised. The Error inside the target still fails loudly if resolution
       comes back empty. -->
  <PropertyGroup Condition="'$(NoBuild)' == 'true'">
    <BuildProjectReferences>false</BuildProjectReferences>
  </PropertyGroup>
  <Target Name="_ResolveBundledAnalyzerFiles" BeforeTargets="_GetPackageFiles" DependsOnTargets="ResolveProjectReferences">
    <ItemGroup>
      <_BundledAnalyzerOutput Include="@(Analyzer)"
        Condition="'%(Analyzer.MSBuildSourceProjectFile)' != '' And (
                     $([System.String]::Copy('%(Analyzer.MSBuildSourceProjectFile)').EndsWith('Excalibur.Dispatch.SourceGenerators.Analyzers.csproj')) Or
                     $([System.String]::Copy('%(Analyzer.MSBuildSourceProjectFile)').EndsWith('Excalibur.Dispatch.SourceGenerators.csproj'))
                   )" />
      <None Include="@(_BundledAnalyzerOutput)" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
    </ItemGroup>
    <Error
      Condition="'@(_BundledAnalyzerOutput)' == ''"
      Text="Could not resolve the SourceGenerators/SourceGenerators.Analyzers build output via @(Analyzer) -- the package would ship WITHOUT DISP001-006 and the typed-invoke source generator. Check that both projects are referenced above with OutputItemType=&quot;Analyzer&quot; and that they build successfully before pack." />
  </Target>
  <ItemGroup>
    <Compile Update="Messaging\Resources\ErrorMessages.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>ErrorMessages.resx</DependentUpon>
    </Compile>
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Update="Messaging\Resources\ErrorMessages.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>ErrorMessages.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>
  <!-- InternalsVisibleTo for unit tests -->
  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>Excalibur.Dispatch.Tests</_Parameter1>
    </AssemblyAttribute>
    <!-- Measurement access: the writer pool is internal, and the benchmark that decides whether
         Microsoft.Extensions.ObjectPool outperforms it has to be able to construct both. -->
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>Excalibur.Dispatch.Benchmarks</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>Excalibur.Tests</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>Excalibur.Dispatch.Patterns.Tests</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>Excalibur.Dispatch.Messaging.Tests</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>Excalibur.Dispatch.Options.Tests</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>Excalibur.Dispatch.Configuration.Tests</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>Excalibur.Dispatch.Diagnostics.Tests</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>Excalibur.Dispatch.DependencyInjection.Tests</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>Excalibur.Dispatch.Serialization.Tests</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>Excalibur.Dispatch.Hosting.Tests</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>Excalibur.Dispatch.Workflows.Tests</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>Excalibur.Dispatch.Abstractions.Tests</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>Excalibur.Dispatch.Tests.Conformance</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>Excalibur.Dispatch.Tests.Functional</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>Excalibur.Dispatch.Tests.Smoke</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>Excalibur.Dispatch.Integration.Tests</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>Excalibur.Dispatch.Performance.Benchmarks</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>Tests.Shared</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>Excalibur.Dispatch.Observability</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>Excalibur.Dispatch.Observability.Tests</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>Excalibur.Dispatch.SourceGenerators.Tests</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>Excalibur.Dispatch.Benchmarks</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>Excalibur.Dispatch.Middleware.Tests</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>Excalibur.Dispatch.Aot.Sample</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>Excalibur.Dispatch.Caching</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>Excalibur.Outbox</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>Excalibur.Cdc.SqlServer</_Parameter1>
    </AssemblyAttribute>
    <!-- The event-sourcing startup validator distinguishes "no registry at all" from "a registry
         holding no types", and only the second is recoverable advice. That check reads the internal
         default registry, which used to live in the abstractions package and was granted there. The
         grant moves with the type; without it the validator cannot tell the two cases apart. -->
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>Excalibur.EventSourcing</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>Excalibur.Dispatch.Messaging.Performance.Tests</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>Excalibur.Dispatch.Core.Tests.Performance</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>Excalibur.Testing.Conformance.Tests</_Parameter1>
    </AssemblyAttribute>
    <!-- InternalsVisibleTo for serializer provider packages (access PluggableSerializationOptions.AddRegistration) -->
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>Excalibur.Dispatch.Serialization.Avro</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>Excalibur.Dispatch.Serialization.MemoryPack</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>Excalibur.Dispatch.Serialization.MessagePack</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>Excalibur.Dispatch.Serialization.Protobuf</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>DynamicProxyGenAssembly2</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>
  <!-- PublicAPI baseline files for breaking change detection -->
  <ItemGroup>
    <!-- Shipped schema: a consumer cannot obtain this DDL unless it is packed, and the
         framework does not auto-create tables. Glob matches where the .sql actually lives. -->
    <None Include="ErrorHandling\PoisonMessage\*.sql" Pack="true" PackagePath="scripts\" />
  </ItemGroup>
</Project>
