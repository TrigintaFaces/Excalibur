<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageId>Excalibur.Dispatch.Transport.IbmMq</PackageId>
    <Description>IBM MQ integration for the Excalibur framework. Provides queue-based messaging with native request/reply over the IBM MQ managed .NET client.</Description>
    <PackageTags>messaging;dispatch;ibm-mq;wmq;queue;enterprise</PackageTags>
    <!-- AOT: NOT compatible. The IBM MQ managed client uses runtime reflection and dynamic assembly loading. -->
    <IsAotCompatible>false</IsAotCompatible>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Excalibur.Dispatch.Abstractions\Excalibur.Dispatch.Abstractions.csproj" />
    <ProjectReference Include="..\Excalibur.Dispatch.Transport.Abstractions\Excalibur.Dispatch.Transport.Abstractions.csproj" />
    <ProjectReference Include="..\Excalibur.Dispatch\Excalibur.Dispatch.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- IBM MQ managed .NET client -->
    <PackageReference Include="IBMMQDotnetClient" />
    <!-- Common dependencies -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Excalibur.Dispatch.Transport.IbmMq.Tests" />
    <InternalsVisibleTo Include="Excalibur.Dispatch.Transport.Tests" />
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
  </ItemGroup>
</Project>
