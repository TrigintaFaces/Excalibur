<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageId>Excalibur.SqlServer</PackageId>
    <Description>Complete SQL Server metapackage for Excalibur: event sourcing, outbox, inbox, sagas, leader election, audit logging, compliance, and data access in a single package reference.</Description>
    <PackageTags>excalibur;sqlserver;event-sourcing;outbox;inbox;saga;leader-election;audit;compliance;metapackage</PackageTags>
    <DispatchPackageVersion Condition="'$(DispatchPackageVersion)' == ''">0.0.0-local</DispatchPackageVersion>
  </PropertyGroup>
  <!-- AOT Configuration -->
  <PropertyGroup>
    <IsAotCompatible>true</IsAotCompatible>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Excalibur.SqlServer.Tests" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />

    <!-- Security floor, referenced directly rather than left transitive. Microsoft.Data.SqlClient
         depends on System.Security.Cryptography.Pkcs 9.0.13, which carries GHSA-846f-f764-76mx
         (high) and GHSA-2fmv-rv2c-59x7 (moderate); its newest release, 7.1.1, still asks for
         9.0.18, also inside the affected 9.0.0-9.0.20 range, so bumping SqlClient does not clear
         it. Central transitive pinning lifts that chain everywhere else in the repository but not
         here, because a metapackage restores its PUBLISHED dependency closure and NuGet does not
         rewrite that. A direct reference does two things at once: it lifts the resolved version in
         this graph, and it declares the floor to the consumer who installs this metapackage, which
         is what a metapackage is for. Remove it once SqlClient depends on a patched Pkcs. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" />
  </ItemGroup>
  <!-- Local development mode: ProjectReference for all SQL Server packages -->
  <ItemGroup Condition="'$(UsePackageReferences)' != 'true'">
    <!-- Starter metapackage (Dispatch + EventSourcing + Outbox + Hosting) -->
    <ProjectReference Include="..\Excalibur.Dispatch.SqlServer\Excalibur.Dispatch.SqlServer.csproj" />
    <!-- Inbox -->
    <ProjectReference Include="..\..\Excalibur\Excalibur.Inbox.SqlServer\Excalibur.Inbox.SqlServer.csproj" />
    <!-- Saga -->
    <ProjectReference Include="..\..\Excalibur\Excalibur.Saga.SqlServer\Excalibur.Saga.SqlServer.csproj" />
    <!-- Leader Election -->
    <ProjectReference Include="..\..\Excalibur\Excalibur.LeaderElection.SqlServer\Excalibur.LeaderElection.SqlServer.csproj" />
    <!-- Audit Logging -->
    <ProjectReference Include="..\..\Excalibur\Excalibur.AuditLogging.SqlServer\Excalibur.AuditLogging.SqlServer.csproj" />
    <!-- Compliance (GDPR, Erasure, Key Escrow) -->
    <ProjectReference Include="..\..\Excalibur\Excalibur.Compliance.SqlServer\Excalibur.Compliance.SqlServer.csproj" />
    <!-- Data Access -->
    <ProjectReference Include="..\..\Excalibur\Excalibur.Data.SqlServer\Excalibur.Data.SqlServer.csproj" />
  </ItemGroup>
  <!-- CI mode: PackageReference for the same persistence stack -->
  <ItemGroup Condition="'$(UsePackageReferences)' == 'true'">
    <PackageReference Include="Excalibur.Dispatch.SqlServer" VersionOverride="$(DispatchPackageVersion)" />
    <PackageReference Include="Excalibur.Inbox.SqlServer" VersionOverride="$(DispatchPackageVersion)" />
    <PackageReference Include="Excalibur.Saga.SqlServer" VersionOverride="$(DispatchPackageVersion)" />
    <PackageReference Include="Excalibur.LeaderElection.SqlServer" VersionOverride="$(DispatchPackageVersion)" />
    <PackageReference Include="Excalibur.AuditLogging.SqlServer" VersionOverride="$(DispatchPackageVersion)" />
    <PackageReference Include="Excalibur.Compliance.SqlServer" VersionOverride="$(DispatchPackageVersion)" />
    <PackageReference Include="Excalibur.Data.SqlServer" VersionOverride="$(DispatchPackageVersion)" />
  </ItemGroup>
</Project>
