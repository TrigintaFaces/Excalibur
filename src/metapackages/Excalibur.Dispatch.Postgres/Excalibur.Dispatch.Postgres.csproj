<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <!-- Composition metapackage: bundles Dispatch with a persistence stack on purpose.
         Exempts this project from the dispatch-no-excalibur boundary rule, and ONLY while its
         public surface stays its registration extension alone. -->
    <CompositionMetapackage>true</CompositionMetapackage>
    <PackageId>Excalibur.Dispatch.Postgres</PackageId>
    <Description>Experience metapackage bundling Excalibur.Dispatch with PostgreSQL event sourcing. Provides a single AddDispatchWithPostgres() call for the common PostgreSQL scenario. No outbox is registered: the PostgreSQL outbox store is built from an application-supplied Excalibur.Data.IDb, which a connection string alone cannot construct.</Description>
    <PackageTags>excalibur;dispatch;postgres;postgresql;event-sourcing;outbox;metapackage</PackageTags>
    <DispatchPackageVersion Condition="'$(DispatchPackageVersion)' == ''">0.0.0-local</DispatchPackageVersion>
  </PropertyGroup>
  <!-- AOT Configuration -->
  <PropertyGroup>
    <IsAotCompatible>true</IsAotCompatible>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
  </ItemGroup>
  <ItemGroup Condition="'$(UsePackageReferences)' != 'true'">
    <ProjectReference Include="..\..\Dispatch\Excalibur.Dispatch\Excalibur.Dispatch.csproj" />
    <ProjectReference Include="..\..\Excalibur\Excalibur.EventSourcing.Postgres\Excalibur.EventSourcing.Postgres.csproj" />
    <ProjectReference Include="..\..\Excalibur\Excalibur.Outbox.Postgres\Excalibur.Outbox.Postgres.csproj" />
  </ItemGroup>
  <!-- CI mode: PackageReference for Dispatch packages -->
  <ItemGroup Condition="'$(UsePackageReferences)' == 'true'">
    <PackageReference Include="Excalibur.Dispatch" VersionOverride="$(DispatchPackageVersion)" />
    <PackageReference Include="Excalibur.EventSourcing.Postgres" VersionOverride="$(DispatchPackageVersion)" />
    <PackageReference Include="Excalibur.Outbox.Postgres" VersionOverride="$(DispatchPackageVersion)" />
  </ItemGroup>
</Project>
