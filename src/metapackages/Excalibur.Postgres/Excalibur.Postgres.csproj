<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageId>Excalibur.Postgres</PackageId>
    <Description>Complete PostgreSQL metapackage for Excalibur: event sourcing, inbox, sagas, leader election, audit logging, compliance, and data access in a single package reference. The outbox is not registered -- its PostgreSQL store requires an application-supplied Excalibur.Data.IDb.</Description>
    <PackageTags>excalibur;postgres;postgresql;event-sourcing;outbox;inbox;saga;leader-election;audit;compliance;metapackage</PackageTags>
  </PropertyGroup>
  <!-- AOT Configuration -->
  <PropertyGroup>
    <IsAotCompatible>true</IsAotCompatible>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Excalibur.Postgres.Tests" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
  </ItemGroup>
  <!-- Local development mode: ProjectReference for all Postgres packages -->
  <ItemGroup Condition="'$(UsePackageReferences)' != 'true'">
    <!-- Starter metapackage (Dispatch + EventSourcing + Outbox + Hosting) -->
    <ProjectReference Include="..\Excalibur.Dispatch.Postgres\Excalibur.Dispatch.Postgres.csproj" />
    <!-- Inbox -->
    <ProjectReference Include="..\..\Excalibur\Excalibur.Inbox.Postgres\Excalibur.Inbox.Postgres.csproj" />
    <!-- Saga -->
    <ProjectReference Include="..\..\Excalibur\Excalibur.Saga.Postgres\Excalibur.Saga.Postgres.csproj" />
    <!-- Leader Election -->
    <ProjectReference Include="..\..\Excalibur\Excalibur.LeaderElection.Postgres\Excalibur.LeaderElection.Postgres.csproj" />
    <!-- Audit Logging -->
    <ProjectReference Include="..\..\Excalibur\Excalibur.AuditLogging.Postgres\Excalibur.AuditLogging.Postgres.csproj" />
    <!-- Compliance (GDPR, Erasure) -->
    <ProjectReference Include="..\..\Excalibur\Excalibur.Compliance.Postgres\Excalibur.Compliance.Postgres.csproj" />
    <!-- Data Access -->
    <ProjectReference Include="..\..\Excalibur\Excalibur.Data.Postgres\Excalibur.Data.Postgres.csproj" />
  </ItemGroup>
  <!--
    Security floor for a Swashbuckle transitive. Central transitive pinning is deliberately off in
    this directory, so the resolved graph would otherwise take Swashbuckle's own minimum of
    Microsoft.OpenApi 2.4.1, in which a circular schema reference can StackOverflow-terminate the
    process (GHSA-v5pm-xwqc-g5wc). PrivateAssets="all" applies the floor to this project's restore
    without emitting the package onto the metapackage's dependency list, which stays the bundle it
    names. Consumers reach the same floor through the implementation packages, which declare it.
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.OpenApi" PrivateAssets="all" />
  </ItemGroup>
</Project>
