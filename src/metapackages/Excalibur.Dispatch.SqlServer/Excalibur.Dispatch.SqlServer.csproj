<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <!-- Composition metapackage: bundles Dispatch with a persistence stack on purpose.
         Exempts this project from the dispatch-no-excalibur boundary rule, and ONLY while its
         public surface stays its registration extension alone. -->
    <CompositionMetapackage>true</CompositionMetapackage>
    <PackageId>Excalibur.Dispatch.SqlServer</PackageId>
    <Description>Experience metapackage bundling Excalibur.Dispatch with SQL Server event sourcing and a SQL Server outbox store. Provides a single AddDispatchWithSqlServer() call for the common SQL Server scenario. The outbox stages messages durably; background delivery is opt-in.</Description>
    <PackageTags>excalibur;dispatch;sqlserver;event-sourcing;outbox;metapackage</PackageTags>
    <DispatchPackageVersion Condition="'$(DispatchPackageVersion)' == ''">0.0.0-local</DispatchPackageVersion>
  </PropertyGroup>
  <!-- AOT Configuration -->
  <PropertyGroup>
    <IsAotCompatible>true</IsAotCompatible>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />

    <!-- Security floor, referenced directly rather than left transitive. Microsoft.Data.SqlClient
         depends on System.Security.Cryptography.Pkcs 9.0.13, which carries GHSA-846f-f764-76mx
         (high) and GHSA-2fmv-rv2c-59x7 (moderate); its newest release, 7.1.1, still asks for
         9.0.18, also inside the affected 9.0.0-9.0.20 range, so bumping SqlClient does not clear
         it. Central transitive pinning lifts that chain everywhere else in the repository but not
         here, because a metapackage restores its PUBLISHED dependency closure and NuGet does not
         rewrite that. A direct reference lifts the resolved version in this graph and declares the
         floor to the consumer who installs this metapackage. Remove it once SqlClient depends on a
         patched Pkcs. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" />
  </ItemGroup>
  <ItemGroup Condition="'$(UsePackageReferences)' != 'true'">
    <ProjectReference Include="..\..\Dispatch\Excalibur.Dispatch\Excalibur.Dispatch.csproj" />
    <ProjectReference Include="..\..\Excalibur\Excalibur.EventSourcing.SqlServer\Excalibur.EventSourcing.SqlServer.csproj" />
    <ProjectReference Include="..\..\Excalibur\Excalibur.Outbox.SqlServer\Excalibur.Outbox.SqlServer.csproj" />
  </ItemGroup>
  <!-- CI mode: PackageReference for Dispatch packages -->
  <ItemGroup Condition="'$(UsePackageReferences)' == 'true'">
    <PackageReference Include="Excalibur.Dispatch" VersionOverride="$(DispatchPackageVersion)" />
    <PackageReference Include="Excalibur.EventSourcing.SqlServer" VersionOverride="$(DispatchPackageVersion)" />
    <PackageReference Include="Excalibur.Outbox.SqlServer" VersionOverride="$(DispatchPackageVersion)" />
  </ItemGroup>
</Project>
