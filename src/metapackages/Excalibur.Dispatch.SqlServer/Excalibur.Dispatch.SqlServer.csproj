<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageId>Excalibur.Dispatch.SqlServer</PackageId>
    <Description>Experience metapackage bundling Excalibur.Dispatch with SQL Server event sourcing and a SQL Server outbox store. Provides a single AddDispatchWithSqlServer() call for the common SQL Server scenario. The outbox stages messages durably; background delivery is opt-in.</Description>
    <PackageTags>excalibur;dispatch;sqlserver;event-sourcing;outbox;metapackage</PackageTags>
    <DispatchPackageVersion Condition="'$(DispatchPackageVersion)' == ''">0.0.0-local</DispatchPackageVersion>
  </PropertyGroup>
  <!-- AOT Configuration -->
  <PropertyGroup>
    <IsAotCompatible>true</IsAotCompatible>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
  </ItemGroup>
  <ItemGroup Condition="'$(UsePackageReferences)' != 'true'">
    <ProjectReference Include="..\..\Dispatch\Excalibur.Dispatch\Excalibur.Dispatch.csproj" />
    <ProjectReference Include="..\..\Excalibur\Excalibur.EventSourcing.SqlServer\Excalibur.EventSourcing.SqlServer.csproj" />
    <ProjectReference Include="..\..\Excalibur\Excalibur.Outbox.SqlServer\Excalibur.Outbox.SqlServer.csproj" />
    <ProjectReference Include="..\..\Excalibur\Excalibur.Hosting.Web\Excalibur.Hosting.Web.csproj" />
  </ItemGroup>
  <!-- CI mode: PackageReference for Dispatch packages -->
  <ItemGroup Condition="'$(UsePackageReferences)' == 'true'">
    <PackageReference Include="Excalibur.Dispatch" VersionOverride="$(DispatchPackageVersion)" />
    <PackageReference Include="Excalibur.EventSourcing.SqlServer" VersionOverride="$(DispatchPackageVersion)" />
    <PackageReference Include="Excalibur.Outbox.SqlServer" VersionOverride="$(DispatchPackageVersion)" />
    <PackageReference Include="Excalibur.Hosting.Web" VersionOverride="$(DispatchPackageVersion)" />
  </ItemGroup>
  <!--
    Security floor for a Swashbuckle transitive. Central transitive pinning is deliberately off in
    this directory, so the resolved graph would otherwise take Swashbuckle's own minimum of
    Microsoft.OpenApi 2.4.1, in which a circular schema reference can StackOverflow-terminate the
    process (GHSA-v5pm-xwqc-g5wc). PrivateAssets="all" applies the floor to this project's restore
    without emitting the package onto the metapackage's dependency list, which stays the bundle it
    names. Consumers reach the same floor through the implementation packages, which declare it.
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.OpenApi" PrivateAssets="all" />
  </ItemGroup>
</Project>
