<?xml version="1.0" encoding="utf-8"?>
<!--
  Coverage settings for the collector built into .NET, selected with the collect argument
  "Code Coverage" (as opposed to "XPlat Code Coverage", which is coverlet).

  Scoping is the same intent as coverage.runsettings' <Include>[Excalibur.*]*</Include> for coverlet,
  expressed in this collector's ModulePaths form: measure our own assemblies, not the third-party SDKs
  that happen to sit in a test output directory, and not the test assemblies themselves.

  ModulePath patterns are regular expressions matched against the full module path, and they are
  case-insensitive.

  The `[^\\/]*` after `Excalibur\.` is load-bearing and must not be relaxed back to `.*`. A `.*`
  CROSSES DIRECTORY SEPARATORS, and every test project lives in `tests/unit/Excalibur.*.Tests/`, so
  `.*\\Excalibur\..*\.dll$` matched that project's ENTIRE output directory -- every third-party SDK
  sitting next to the test assembly. Measured on a real shard artifact: 16 foreign packages (Dapper,
  DiffEngine, FakeItEasy, Shouldly, xunit.v3 x6, ...) = 52,900 of 170,850 lines, 31% of the report,
  attributed to us. The character class holds the match inside a single path segment, which is what
  "the assembly is named Excalibur.<something>" actually means.
-->
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="Code Coverage">
        <Configuration>
          <CodeCoverage>
            <ModulePaths>
              <Include>
                <ModulePath>.*\\Excalibur\.[^\\/]*\.dll$</ModulePath>
                <ModulePath>.*/Excalibur\.[^\\/]*\.dll$</ModulePath>
              </Include>
              <Exclude>
                <!-- Test assemblies measure the tests, not the product. Coverlet's equivalent is
                     IncludeTestAssembly=false. -->
                <ModulePath>.*Tests\.dll$</ModulePath>
                <ModulePath>.*Testing\.dll$</ModulePath>
                <ModulePath>.*Testing\..*\.dll$</ModulePath>
                <ModulePath>.*Testing\.Conformance\.dll$</ModulePath>
              </Exclude>
            </ModulePaths>

            <Attributes>
              <Exclude>
                <Attribute>^System\.Diagnostics\.DebuggerHiddenAttribute$</Attribute>
                <Attribute>^System\.Diagnostics\.DebuggerNonUserCodeAttribute$</Attribute>
                <Attribute>^System\.CodeDom\.Compiler\.GeneratedCodeAttribute$</Attribute>
                <Attribute>^System\.Runtime\.CompilerServices\.CompilerGeneratedAttribute$</Attribute>
                <Attribute>^System\.Diagnostics\.CodeAnalysis\.ExcludeFromCodeCoverageAttribute$</Attribute>
                <Attribute>^System\.ObsoleteAttribute$</Attribute>
              </Exclude>
            </Attributes>

            <Sources>
              <Exclude>
                <Source>.*\\obj\\.*</Source>
                <Source>.*/obj/.*</Source>
                <Source>.*\.g\.cs$</Source>
                <Source>.*\.generated\.cs$</Source>
              </Exclude>
            </Sources>

            <CollectFromChildProcesses>True</CollectFromChildProcesses>
          </CodeCoverage>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
