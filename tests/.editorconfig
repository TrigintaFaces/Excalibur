# Test-tree editorconfig overlay (cascades on top of the repo-root .editorconfig).

# 1b54fe: the sync-over-async ban (RS0030, BannedApiAnalyzers) is a build ERROR in test SOURCE, and
# EXEMPT in generated obj/ code. The xUnit v3 AUTO-GENERATED entry point
# (obj/**/XunitAutoGeneratedEntryPoint.cs) necessarily calls .GetAwaiter().GetResult() in its synchronous
# Main; it is regenerated per build (cannot be pragma'd) and is NOT a *.g.cs (so the root config's
# generated rules miss it). Severity is set HERE, not via <WarningsAsErrors>RS0030 in props — a
# project-level WarningsAsErrors would RE-ELEVATE RS0030 even on files marked severity=none, defeating the
# exemption. A more-specific obj/ section overrides the source [*.cs] rule for generated files.
[*.cs]
dotnet_diagnostic.RS0030.severity = error

[**/obj/**/*.cs]
generated_code = true
dotnet_diagnostic.RS0030.severity = none

[**/XunitAutoGeneratedEntryPoint.cs]
generated_code = true
dotnet_diagnostic.RS0030.severity = none
