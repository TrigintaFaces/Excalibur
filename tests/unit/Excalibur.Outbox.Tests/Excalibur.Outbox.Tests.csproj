<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>Excalibur.Outbox.Tests</RootNamespace>
    <AssemblyName>Excalibur.Outbox.Tests</AssemblyName>
    <!-- Carried from Excalibur.Outbox.Tests and Outbox.SqlServer.Tests -->
    <NoWarn>$(NoWarn);MA0038;CA2201</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <!-- Test framework (Microsoft.NET.Test.Sdk, xunit, xunit.runner.visualstudio) provided by Directory.Build.props -->
    <PackageReference Include="Shouldly" />
    <PackageReference Include="FakeItEasy" />
    <PackageReference Include="coverlet.collector" />
  </ItemGroup>
  <ItemGroup>
    <!-- ProjectReferences from all merged outbox test projects -->
    <!-- From Excalibur.Outbox.Tests -->
    <ProjectReference Include="..\..\..\src\Excalibur\Excalibur.Outbox\Excalibur.Outbox.csproj" />
    <!-- From Excalibur.Outbox.SqlServer.Tests -->
    <ProjectReference Include="..\..\..\src\Excalibur\Excalibur.Outbox.SqlServer\Excalibur.Outbox.SqlServer.csproj" />
    <!-- From Excalibur.Outbox.CosmosDb.Tests -->
    <ProjectReference Include="..\..\..\src\Excalibur\Excalibur.Outbox.CosmosDb\Excalibur.Outbox.CosmosDb.csproj" />
    <!-- From Excalibur.Outbox.DynamoDb.Tests -->
    <ProjectReference Include="..\..\..\src\Excalibur\Excalibur.Outbox.DynamoDb\Excalibur.Outbox.DynamoDb.csproj" />
    <!-- From Excalibur.Outbox.Firestore.Tests -->
    <ProjectReference Include="..\..\..\src\Excalibur\Excalibur.Outbox.Firestore\Excalibur.Outbox.Firestore.csproj" />
    <!-- Sprint 628: Outbox.MongoDB bridge package (provides UseMongoDB extension, transitively references Data.MongoDB) -->
    <ProjectReference Include="..\..\..\src\Excalibur\Excalibur.Outbox.MongoDB\Excalibur.Outbox.MongoDB.csproj" />
    <!-- Inbox.SqlServer (SqlServerInboxOptions, InboxEntry used in SqlServerOutboxStoreShould tests) -->
    <ProjectReference Include="..\..\..\src\Excalibur\Excalibur.Inbox.SqlServer\Excalibur.Inbox.SqlServer.csproj" />
    <!-- Sprint 637 B.2/B.6: Outbox ElasticSearch + Redis builder extension tests -->
    <ProjectReference Include="..\..\..\src\Excalibur\Excalibur.Outbox.ElasticSearch\Excalibur.Outbox.ElasticSearch.csproj" />
    <ProjectReference Include="..\..\..\src\Excalibur\Excalibur.Outbox.Redis\Excalibur.Outbox.Redis.csproj" />
    <ProjectReference Include="..\..\..\src\Excalibur\Excalibur.Outbox.InMemory\Excalibur.Outbox.InMemory.csproj" />
    <!-- Real inbox store for the drain finalize-key regression lock (InboxProcessorFinalizeKeyShould). -->
    <ProjectReference Include="..\..\..\src\Excalibur\Excalibur.Inbox.InMemory\Excalibur.Inbox.InMemory.csproj" />
    <!-- A real binary IPayloadSerializer, so the inbox round-trip lock writes and drains a payload
         the JSON reader structurally cannot parse. -->
    <ProjectReference Include="..\..\..\src\Dispatch\Excalibur.Dispatch.Serialization.MessagePack\Excalibur.Dispatch.Serialization.MessagePack.csproj" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\\..\\Shared\\Tests.Shared\Tests.Shared.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- The SQL Server DDL the package ships to consumers. Linked in so a test can read the exact bytes a
         consumer runs; the integration fixtures hand-write their own CREATE TABLE, so without this nothing
         in the tree looks at the shipped script at all. -->
    <EmbeddedResource Include="..\..\..\src\Excalibur\Excalibur.Outbox.SqlServer\Scripts\001_CreateOutboxSchema.sql" Link="Schema\001_CreateSqlServerOutboxSchema.sql" />
  </ItemGroup>
</Project>