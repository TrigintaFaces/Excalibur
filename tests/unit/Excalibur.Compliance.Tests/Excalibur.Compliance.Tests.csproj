<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>Excalibur.Compliance.Tests</RootNamespace>
    <AssemblyName>Excalibur.Compliance.Tests</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Shouldly" />
    <PackageReference Include="FakeItEasy" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="coverlet.collector" />
    <!-- Reads back the generated SOC 2 PDF so the export-option locks assert on the rendered
         artifact (page count, page geometry, extracted text). -->
    <PackageReference Include="PdfPig" />
  </ItemGroup>
  <ItemGroup>
    <!--
      The SHIPPED SQL Server compliance DDL, linked so a unit arm can read the artifact a CONSUMER
      applies rather than the auto-create text inside the store. Those are two independent
      definitions of one schema, and only the auto-create one was exercised by any test: a
      certificate column present in the store and absent from this script shipped undetected.
      Linked under a dialect-named folder because both dialects ship a file with this leaf name.
    -->
    <EmbeddedResource Include="..\..\..\src\Excalibur\Excalibur.Compliance.SqlServer\Scripts\001_CreateComplianceSchema.sql" Link="Schema\SqlServer\001_CreateComplianceSchema.sql" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\..\src\Excalibur\Excalibur.Compliance\Excalibur.Compliance.csproj" />
    <ProjectReference Include="..\..\..\src\Excalibur\Excalibur.Compliance.Pdf\Excalibur.Compliance.Pdf.csproj" />
    <ProjectReference Include="..\..\..\src\Excalibur\Excalibur.Compliance.MongoDb\Excalibur.Compliance.MongoDb.csproj" />
    <ProjectReference Include="..\..\..\src\Excalibur\Excalibur.Compliance.Postgres\Excalibur.Compliance.Postgres.csproj" />
    <ProjectReference Include="..\..\..\src\Excalibur\Excalibur.Compliance.SqlServer\Excalibur.Compliance.SqlServer.csproj" />
    <ProjectReference Include="..\..\..\src\Excalibur\Excalibur.Compliance.Aws\Excalibur.Compliance.Aws.csproj" />
    <ProjectReference Include="..\..\..\src\Excalibur\Excalibur.Compliance.Azure\Excalibur.Compliance.Azure.csproj" />
    <ProjectReference Include="..\..\..\src\Excalibur\Excalibur.Compliance.Vault\Excalibur.Compliance.Vault.csproj" />
    <ProjectReference Include="..\..\..\src\Excalibur\Excalibur.Hosting\Excalibur.Hosting.csproj" />
    <ProjectReference Include="..\..\..\src\Excalibur\Excalibur.Outbox\Excalibur.Outbox.csproj" />
    <ProjectReference Include="..\..\..\src\Excalibur\Excalibur.Outbox.InMemory\Excalibur.Outbox.InMemory.csproj" />
    <ProjectReference Include="..\..\..\src\Excalibur\Excalibur.Inbox\Excalibur.Inbox.csproj" />
    <ProjectReference Include="..\..\..\src\Excalibur\Excalibur.Inbox.InMemory\Excalibur.Inbox.InMemory.csproj" />
    <ProjectReference Include="..\\..\\Shared\\Tests.Shared\Tests.Shared.csproj" />
  </ItemGroup>
</Project>