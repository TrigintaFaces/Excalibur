<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>Excalibur.Metapackages.Tests</RootNamespace>
    <AssemblyName>Excalibur.Metapackages.Tests</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <!-- Test framework (Microsoft.NET.Test.Sdk, xunit, xunit.runner.visualstudio) provided by Directory.Build.props -->
    <PackageReference Include="Shouldly" />
    <PackageReference Include="coverlet.collector" />
  </ItemGroup>
  <ItemGroup>
    <!-- The subjects: the one-line entry points a consumer copies out of the getting-started docs. -->
    <ProjectReference Include="..\..\..\src\metapackages\Excalibur.Dispatch.SqlServer\Excalibur.Dispatch.SqlServer.csproj" />
    <ProjectReference Include="..\..\..\src\metapackages\Excalibur.Dispatch.Postgres\Excalibur.Dispatch.Postgres.csproj" />
    <ProjectReference Include="..\..\..\src\metapackages\Excalibur.Dispatch.AspNetCore\Excalibur.Dispatch.AspNetCore.csproj" />
    <ProjectReference Include="..\..\..\src\metapackages\Excalibur.Dispatch.Aws\Excalibur.Dispatch.Aws.csproj" />
    <ProjectReference Include="..\..\..\src\metapackages\Excalibur.Dispatch.Azure\Excalibur.Dispatch.Azure.csproj" />
    <!-- The full-stack metapackages: the single call a consumer makes to get everything. -->
    <ProjectReference Include="..\..\..\src\metapackages\Excalibur.SqlServer\Excalibur.SqlServer.csproj" />
    <ProjectReference Include="..\..\..\src\metapackages\Excalibur.Postgres\Excalibur.Postgres.csproj" />
    <!-- Leader election, so the outbox fencing invariant can be armed and exercised: registering a
         leader gate is what makes the startup fencing check fire. -->
    <ProjectReference Include="..\..\..\src\Excalibur\Excalibur.LeaderElection.SqlServer\Excalibur.LeaderElection.SqlServer.csproj" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\Shared\Tests.Shared\Tests.Shared.csproj" />
  </ItemGroup>
</Project>
