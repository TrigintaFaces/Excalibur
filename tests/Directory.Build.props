<Project>
  <!--
    Global test project settings
    Suppresses style and code analysis rules that are overly restrictive for test code
    These suppressions allow tests to build and execute while maintaining production code quality
  -->

  <!-- ============================================================================================
       Sprint 325 T0.2: Project Classification Metadata (AD-325-2)
       ============================================================================================
       All projects under tests/ are classified as "Test" by default.
       - IsTestProject=true (xUnit test SDK enabled)
       - IsPackable=false (tests are not packaged)
       ============================================================================================ -->
  <PropertyGroup>
    <IsTestProject>true</IsTestProject>
    <IsPackable>false</IsPackable>
    <ProjectClassification>Test</ProjectClassification>
    <RepositoryRoot>$(MSBuildThisFileDirectory)..\</RepositoryRoot>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Suppress analyzer warnings that block test builds -->
    <!-- Documentation: Test methods are internal; XML docs add no value -->
    <!-- CS1591: Missing XML comment for publicly visible type or member -->
    <!-- SA1600: Elements should be documented -->
    <!-- SA1611: Element parameters should be documented -->
    <!-- SA1615: Element return value should be documented -->
    <!-- SA1618: Generic type parameters should be documented -->
    <!-- SA1648: InheritDoc should be used with inheriting documentation -->
    <!-- RCS1141: Add parameter to documentation comment -->

    <!-- SA1402: File may only contain a single type (test helpers often grouped) -->
    <!-- RCS1046: Add suffix 'Async' to asynchronous method name (test naming conventions) -->
    <!-- CA1307: String operations should specify StringComparison (test clarity over perf) -->
    <!-- CA1707: Identifiers should not contain underscores (test_naming_pattern) -->
    <!-- CA1305: IFormatProvider for string operations (not critical in tests) -->
    <!-- CA1848: Use LoggerMessage delegates (performance not critical in tests) -->
    <!-- CA1849: Synchronous blocking detected (some test setups require it) -->
    <!-- CA1854: Prefer TryGetValue over ContainsKey (readability in tests) -->
    <!-- CA1860: Prefer IsEmpty check rather than Any() (test clarity) -->
    <!-- CA1812: Internal class never instantiated (test middleware/helpers) -->
    <!-- CA5394: Random is insecure (acceptable in test data generation) -->
    <!-- CA1506: Class coupling too high (integration tests expected) -->
    <!-- CA2000: Dispose objects (test setup/teardown handles lifecycle) -->
    <!-- CA1310: StringComparison not always needed in tests -->
    <!-- xUnit1030: ConfigureAwait(false) in tests (xUnit-specific rule) -->
    <!-- xUnit1051: Use TestContext.Current.CancellationToken (new v3 rule — bulk migration deferred) -->
    <!-- CA1816: GC.SuppressFinalize in DisposeAsync — v3 IAsyncLifetime inherits IAsyncDisposable, triggers on all test lifecycle methods -->
    <!-- MA0020: Use TrueForAll() instead of All() (test readability) -->
    <!-- MA0044: Remove useless ToString call (test assertions sometimes need it) -->
    <!-- Suppress duplicate package reference warnings (NU1504) -->
    <!-- These packages are intentionally duplicated between Directory.Build.props and individual test projects -->
    <!-- CA1873: Avoid expensive log arguments (not critical in tests) -->
    <!-- CS8602: Dereference of a possibly null reference (tests intentionally test null scenarios) -->
    <!-- CS8604: Possible null reference argument (tests intentionally pass null to verify behavior) -->
    <!-- CS9113: Parameter is unread (test helper classes use primary constructors for consistency) -->
    <!-- CS8625: Cannot convert null literal to non-nullable (tests intentionally test null scenarios) -->
    <!-- NU1510: net10 SDK package-pruning hint (informational; per-package cleanup tracked by S797 Workstream B) -->
    <NoWarn>$(NoWarn);CS1591;SA1600;SA1611;SA1615;SA1618;SA1648;RCS1141;SA1402;RCS1046;CA1307;CA1707;CA1305;CA1848;CA1849;CA1854;CA1860;CA1812;CA1873;CA5394;CA1506;CA2000;CA1310;CA1816;xUnit1030;xUnit1051;MA0020;MA0044;NU1504;CS8602;CS8604;CS8625;CS9113;CA1711;CA1823;CA1852;CA1859;NU1510</NoWarn>

    <!-- Allow test-friendly code style -->
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
  </PropertyGroup>

  <!-- xUnit v3 requires OutputType=Exe for test projects (not class libraries like Tests.Shared) -->
  <PropertyGroup Condition="'$(IsTestProject)' == 'true'">
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <!-- Ensure all test projects get the test SDK packages -->
  <ItemGroup Condition="'$(IsTestProject)' == 'true'">
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <!-- Copy the shared xunit.runner.json (parallel execution) ONLY when a project does not supply
       its own. A project-local xunit.runner.json is authoritative: integration suites ship a serial
       config (parallelizeTestCollections=false, maxParallelThreads=1) because they start real
       containers, and starting them concurrently exhausts host memory (containers killed with
       SIGABRT/SIGKILL). Without this condition both files copy to the same output path and the
       shared parallel config can win, silently defeating the serial policy. -->
  <ItemGroup Condition="!Exists('$(MSBuildProjectDirectory)/xunit.runner.json')">
    <None Include="$(MSBuildThisFileDirectory)xunit.runner.json" CopyToOutputDirectory="PreserveNewest" Link="xunit.runner.json" />
  </ItemGroup>

  <!-- Test categorization traits -->
  <PropertyGroup>
    <!-- Enable parallel test execution at solution level -->
    <RunSettingsFilePath>$(MSBuildThisFileDirectory)test.runsettings</RunSettingsFilePath>
  </PropertyGroup>

  <!-- ============================================================================================
       1b54fe: sync-over-async BLOCKING-API gate for TEST code (BannedApiAnalyzers, RS0030).
       Bans .Result / .Wait*/ Thread.Sleep / .GetAwaiter().GetResult() in tests (dotnet-best-practices
       async rules + testing-patterns §1). `Task.Delay` is INTENTIONALLY allowed (an awaited Delay is
       non-blocking; the ~112 legit uses stay green). Banned set: eng/banned/BannedSymbols.Tests.txt.

       Enabled by DEFAULT for EVERY test project — so NEW sync-over-async is caught everywhere. The
       ~44 PRE-EXISTING debt sites in ~15 test projects are baselined with per-line
       `#pragma warning disable RS0030 // bd-c36hwe: sync-over-async debt` (migration bead c36hwe removes
       each pragma as the site is fixed to `await`) — NOT whole-project opt-out, which would ungate ~half
       the test tree to new violations (SA ruling S887). `TestTiming.cs`'s 4 Thread.Sleep are the
       SANCTIONED central blocking primitive → per-line pragma with a permanent-exemption comment (not
       debt). Only BENCHMARKS are whole-project opt-out ([GlobalSetup] is legitimately synchronous).
       ============================================================================================ -->
  <PropertyGroup>
    <!-- Semicolon-delimited (leading + trailing ';'). ONLY benchmarks opt out wholesale; every real
         test project stays gated (pre-existing debt is per-line-pragma'd, tracked by bead c36hwe). -->
    <!-- Benchmarks: [GlobalSetup] is legitimately synchronous. Integration/Functional/Conformance:
         infra-heavy (TestContainers/Docker) — cannot be build-verified in every dev env, so opted out
         until c36hwe migrates + gates them with a real-infra build. All UNIT test projects stay gated. -->
    <BannedApiTestOptOut>;Excalibur.Compliance.Benchmarks;Excalibur.Dispatch.Performance.Benchmarks;Excalibur.Integration.Tests;Excalibur.Dispatch.Integration.Tests;Excalibur.Dispatch.Tests.Conformance;Excalibur.Dispatch.Tests.Functional;</BannedApiTestOptOut>
    <!-- Master rollout switch. Set BannedApiTestsEnabled=true to arm the gate for all non-opt-out test
         projects. Kept OFF until the per-line pragma-baseline of the ~44 pre-existing sites is COMPLETE
         and build-verified across the whole test tree — arming it before then reddens the shared tree for
         every agent (a partially-pragma'd baseline). Flip to true in the SAME commit as the completed
         baseline. -->
    <BannedApiTestsEnabled Condition="'$(BannedApiTestsEnabled)' == ''">true</BannedApiTestsEnabled>
    <EnableBannedApiAnalyzers Condition="'$(EnableBannedApiAnalyzers)' == '' and '$(BannedApiTestsEnabled)' == 'true' and !$(BannedApiTestOptOut.Contains(';$(MSBuildProjectName);'))">true</EnableBannedApiAnalyzers>
    <EnableBannedApiAnalyzers Condition="'$(EnableBannedApiAnalyzers)' == ''">false</EnableBannedApiAnalyzers>
    <BannedSymbolsFile Condition="'$(BannedSymbolsFile)' == ''">$(MSBuildThisFileDirectory)..\eng\banned\BannedSymbols.Tests.txt</BannedSymbolsFile>
  </PropertyGroup>

  <ItemGroup Condition="'$(EnableBannedApiAnalyzers)' == 'true'">
    <PackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" PrivateAssets="all" />
  </ItemGroup>
  <!-- BannedApiAnalyzers only reads an AdditionalFile LINKED as 'BannedSymbols.txt' (regardless of its
       source name), so link the tests file under that name — mirrors src/Directory.Build.props. -->
  <ItemGroup Condition="'$(EnableBannedApiAnalyzers)' == 'true' and Exists('$(BannedSymbolsFile)')">
    <AdditionalFiles Include="$(BannedSymbolsFile)" Link="BannedSymbols.txt" Visible="false" />
  </ItemGroup>
  <!-- RS0030 severity (error in source, none in generated obj/ code) is set via tests/.editorconfig, NOT
       here: a project-level <WarningsAsErrors>RS0030 RE-ELEVATES the diagnostic even on files an
       editorconfig marks severity=none (overriding the generated-code exemption for the xUnit v3
       auto-generated entry point, which necessarily uses .GetAwaiter().GetResult()). editorconfig wins. -->
</Project>
