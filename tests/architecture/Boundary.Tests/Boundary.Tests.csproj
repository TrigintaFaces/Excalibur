<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsTestProject>true</IsTestProject>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Boundary.Tests</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
    <!-- Code-fix assemblies keep Roslyn dependencies private; complete type inspection needs them here. -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="NetArchTest.Rules" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Shouldly" />
    <PackageReference Include="YamlDotNet" />
  </ItemGroup>
  <!--
    Boundary-guard dependency closure. The architecture guards enumerate the loaded framework assemblies
    (AppDomain.CurrentDomain.GetAssemblies() / NetArchTest Types.InCurrentDomain()) and reflect over their
    types, which forces resolution of every TRANSITIVE dependency of the framework assemblies under test.

    Rather than hand-maintain a package list that silently rots when the framework gains a transitive
    dependency, we ProjectReference every framework project and let MSBuild compute the complete transitive
    closure into this test's output directory. BoundaryFrameworkAssemblyFixture then force-loads the framework
    assemblies named in the dependency manifest before execution (not discovery), so the enumeration is
    complete and order-independent, and every transitive
    dependency resolves naturally from the same directory. This is enforcing (it reveals the true type set,
    never masks a boundary violation — a forbidden reference is visible in GetReferencedAssemblies metadata)
    and self-maintaining (a new project or dependency flows in without editing this file).

    Source-generator projects are excluded. Analyzer/code-fix projects present in the closure are also
    inspected; the explicit Roslyn workspace dependency above closes their private runtime dependencies.

    The Microsoft.AspNetCore.App FrameworkReference supplies the ASP.NET Core / shared-framework assemblies
    (e.g. Mvc.Core, ObjectPool) that are not copied into a library project's output.
  -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <ProjectReference Include="..\..\..\src\**\*.csproj"
                      Exclude="..\..\..\src\**\*SourceGenerators*.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="System" />
    <Using Include="System.IO" />
    <Using Include="System.Linq" />
    <Using Include="System.Xml.Linq" />
    <Using Include="System.Collections.Generic" />
    <Using Include="Xunit" />
    <Using Include="Shouldly" />
  </ItemGroup>
  <Import Project="PristineOptionLivenessInputs.targets" />
  <ItemGroup>
    <ProjectReference Include="../../../eng/tools/RepositoryChecks/RepositoryChecks.csproj" />
    <ProjectReference Include="../../../eng/tools/RepositoryAnalyzers/RepositoryAnalyzers.csproj" />
  </ItemGroup>
</Project>
